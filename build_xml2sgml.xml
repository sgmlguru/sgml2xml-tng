<?xml version="1.0" encoding="UTF-8"?>
<project
	xmlns:sgml="sgml"	
	basedir="."
	name="xml2sgml" 
	default="all">
	
	<!-- load ant-contrib -->
	<taskdef resource="net/sf/antcontrib/antlib.xml"/>
	
	<tstamp>
		<format property="current.time" pattern="yyyyMMddHHmmss"/>
	</tstamp>
	
	<property environment="env"/>
	
	<condition property="isWindows">
		<os family="windows" />
	</condition>
	
	<condition property="isLinux">
		<os family="unix" />
	</condition>
	
	<!-- Local properties -->
	<xmlproperty
		file="./build_xml2sgml.properties.local.xml"
		keeproot="false"
		collapseattributes="true"
		semanticattributes="true"/>
	
	<!-- Default properties -->
	<xmlproperty
		file="./build_xml2sgml.properties.xml"
		keeproot="false"
		collapseattributes="true"
		semanticattributes="true"/>
	
	<!-- Module-specific properties -->
	<xmlproperty
		file="${modules}/${current-module}/module.properties.local.xml"
		keeproot="false"
		collapseattributes="true"
		semanticattributes="true"/>
	<xmlproperty
		file="${modules}/${current-module}/module.properties.xml"
		keeproot="false"
		collapseattributes="true"
		semanticattributes="true"/>
	
	<echo message="Current module spec: ${modules}/${current-module}/${current-module}.properties.xml"/>
	
	<taskdef file="${repos.xml2sgml}/ant/antlib.xml" uri="sgml"/>
	
	<!-- Create dirs -->
	<target name="mkdirs" description="Create target directories">
		<mkdir dir="${base.tmp}"/>
		<mkdir dir="${base.charmaps}"/>
		<mkdir dir="${base.spam}"/>
		<mkdir dir="${base.doctypes}"/>
		<mkdir dir="${base.expand-empty}"/>
		<mkdir dir="${base.out}"/>
		<mkdir dir="${base.report}"/>
		<mkdir dir="${base.debug}"/>
	</target>

	<target name="copy-graphics" description="Copy any input graphics to the output">
		<mkdir dir="${base.out}"/>
		<!-- Preserves subdirectory structures for non-XML graphic assets -->
		<copy todir="${base.out}">
			<fileset dir="${base.source}" excludes="**/*.xml"/>
		</copy>
	</target>
	
	<!-- Expand empty -->
	<target name="loop-empty" description="Loop the inputs, fix the XML for each">				
		<foreach target="expand-empty" param="file" inheritall="true">
			<path>
				<fileset dir="${base.source}">
					<include name="**/*.xml"/>
					<exclude name="build*"/>
				</fileset>
			</path>
		</foreach>
	</target>
	
	<target name="expand-empty" description="Expand EMPTY elements, tweak XML">		
		<local name="local.relative-path"/>
		<local name="local.output-filepath"/>
		
		<pathconvert property="local.relative-path" setonempty="false">
			<path path="${file}"/>
			<map from="${base.source}/" to=""/>
			<map from="${base.source}\" to=""/>
		</pathconvert>
		
		<property name="local.output-filepath" value="${base.expand-empty}/${local.relative-path}"/>
		
		<dirname property="local.output-dir" file="${local.output-filepath}"/>
		<mkdir dir="${local.output-dir}"/>
		<local name="local.output-dir"/>
		
		<echo message="Getting rid of XML constructs and expanding EMPTY tags in ${file}"/>
		
		<java
			classname="net.sf.saxon.Transform" 
			fork="yes"
			failonerror="true">
			<classpath>
				<pathelement path="${saxon.jar}"/>
				<pathelement path="${morgana.resolver}"/>
			</classpath>
			<arg line="-catalog:${modules}/${current-module}/catalogs/catalog.xml"/>
			<arg value="-s:${file}"/>
			<arg value="-xsl:${modules.common.xslt.xml2sgml.expand-empty}"/>
			<arg value="-o:${local.output-filepath}"/>
		</java>
		
		<echo message="...saved as ${local.output-filepath}"/>
	</target>
	
	<!-- ISO-encode -->
	<target name="loop-charmaps" description="Loop the inputs, ISO-encode each">
		<foreach target="charmap-xslt" param="file" inheritall="true">
			<path>
				<fileset dir="${base.expand-empty}">
					<include name="**/*.xml"/>
				</fileset>
			</path>
		</foreach>
	</target>
	
	<target name="charmap-xslt" description="Generate DOCTYPE, ISO-encode the input XML">
		<local name="local.relative-path"/>
		<local name="local.output-filepath"/>
		<local name="local.output-doctype"/>
		<local name="local.dtds"/>
		
		<!-- Map relative path relative to the prior base directory -->
		<pathconvert property="local.relative-path" setonempty="false">
			<path path="${file}"/>
			<map from="${base.expand-empty}/" to=""/>
			<map from="${base.expand-empty}\" to=""/>
		</pathconvert>
		
		<property name="local.output-filepath" value="${base.charmaps}/${local.relative-path}"/>
		<property name="local.output-doctype" value="${base.doctypes}/${local.relative-path}"/>
		
		<!-- Ensure output directories exist for both staging paths -->
		<dirname property="local.output-dir" file="${local.output-filepath}"/>
		<mkdir dir="${local.output-dir}"/>
		<local name="local.output-dir"/>

		<dirname property="local.doctype-dir" file="${local.output-doctype}"/>
		<mkdir dir="${local.doctype-dir}"/>
		<local name="local.doctype-dir"/>
		
		<!-- Generate full DOCTYPE -->
		<java classname="net.sf.saxon.Transform" fork="yes">
			<classpath>
				<pathelement path="${saxon.jar}"/>
				<pathelement path="${morgana.resolver}"/>
			</classpath>
			<arg line="-catalog:${modules}/${current-module}/catalogs/catalog.xml"/>
			<arg value="-s:${file}"/>
			<arg value="-xsl:${modules.common.xslt.xml2sgml.generate-doctype}"/>
			<arg value="-o:${local.output-doctype}"/>
			<arg value="doctype-lookup-uri=${module.schemas.sgml-doctypes}"/>
		</java>              
		
		<echo message="...saved as ${local.output-doctype}"/>
		<echo message="Converting ${file} to ISO encoding"/>
		
		<makeurl property="local.dtds" file="${modules}/${current-module}/schemas"/>
		
		<java
			classname="net.sf.saxon.Transform" 
			fork="yes"
			failonerror="true">
			<classpath>
				<pathelement path="${saxon.jar}"/>
				<pathelement path="${morgana.resolver}"/>
			</classpath>
			<arg line="-catalog:${modules}/${current-module}/catalogs/catalog.xml"/>
			<arg value="-s:${file}"/>
			<arg value="-xsl:${modules.common.xslt.xml2sgml.iso-encode}"/>
			<arg value="-o:${local.output-filepath}"/>
			<arg value="repos.dtds=${local.dtds}"/>
		</java>
		
		<echo message="...saved as ${local.output-filepath}"/>
	</target>
	
	<!-- Normalise using spam -->
	<target name="loop-spam" description="Loop the ISO-encoded files, run spam on each">
		<foreach target="spam" param="file" inheritall="true">
			<path>
				<fileset dir="${base.charmaps}">
					<include name="**/*.xml"/>
				</fileset>
			</path>
		</foreach>
	</target>
	
	<target name="spam" description="Normalise the SGML using spam">
		<local name="local.relative-path"/>
		<local name="local.relative-path-without-extension"/>
		
		<local name="local.doctype"/>
		<local name="local.source-with-doctype-xml"/>
		<local name="local.source-normalised"/>
		<local name="local.final-output-sgml"/>
		
		<local name="local.spam-report"/>
		<local name="local.output-dir"/>
		<local name="sp-loc.path.spam"/>
		
		<!-- Extract the subfolder + filename syntax -->
		<pathconvert property="local.relative-path" setonempty="false">
			<path path="${file}"/>
			<map from="${base.charmaps}/" to=""/>
			<map from="${base.charmaps}\" to=""/>
		</pathconvert>
		
		<!-- Strip the .xml extension manually to retain subfolders safely -->
		<pathconvert property="local.relative-path-without-extension" setonempty="false">
			<path path="${file}"/>
			<map from="${base.charmaps}/" to=""/>
			<map from="${base.charmaps}\" to=""/>
			<mapper type="glob" from="*.xml" to="*"/>
		</pathconvert>
		
		<!-- Map dynamic locations preserving subfolder branches -->
		<property name="local.doctype" location="${base.doctypes}/${local.relative-path}"/>
		<property name="local.source-with-doctype-xml" location="${base.spam}/${local.relative-path}"/>
		<property name="local.source-normalised" location="${base.spam}/${local.relative-path-without-extension}.sgm"/>
		<property name="local.final-output-sgml" location="${base.out}/${local.relative-path-without-extension}.sgm"/>
		
		<!-- Set up intermediate directory buffers -->
		<dirname property="local.output-dir" file="${local.source-normalised}"/>
		<mkdir dir="${local.output-dir}"/>
		<local name="local.output-dir"/>
		
		<!-- Fixed: dynamically generating subfolders down inside the report output directory -->
		<property name="local.spam-report" location="${base.report}/${local.relative-path-without-extension}.txt"/>
		<dirname property="local.report-dir" file="${local.spam-report}"/>
		<mkdir dir="${local.report-dir}"/>
		<local name="local.report-dir"/>
		
		<!-- Make sure final base.out subfolder exists before writing SGML -->
		<dirname property="local.final-out-dir" file="${local.final-output-sgml}"/>
		<mkdir dir="${local.final-out-dir}"/>
		<local name="local.final-out-dir"/>
		
		<sgml:insert-doctype
			source="${file}"
			doctype="${local.doctype}"
			result="${local.source-with-doctype-xml}"/>
		
		<echo message="Normalising ${file} using ${module.schemas.input}"/>
		<echo message="Spam report to ${local.spam-report}"/>
		
		<!-- Set path to spam -->
		<condition property="sp-loc.path.spam" value="${sp-loc.win-path.spam}">
			<isset property="isWindows"/>
		</condition>
		<condition property="sp-loc.path.spam" value="${sp-loc.nix-path.spam}">
			<isset property="isLinux"/>
		</condition>
		
		<echo message="Spam executable (isLinux = ${isLinux}, isWindows = ${isWindows}): ${sp-loc.path.spam}"/>
		
		<exec
			executable="${sp-loc.path.spam}" 
			inputstring="&#10;"
			output="${local.source-normalised}"
			failonerror="false">
			<arg value="-E0"/>
			<arg value="-wno-empty"/>
			<arg value="-wno-min-tag"/>
			<arg value="-mreserved"/>
			<arg value="-f${local.spam-report}"/>
			<arg value="-c"/>
			<arg line="${module.schemas.input}"/>
			<arg value="${local.source-with-doctype-xml}"/>
		</exec>
		
		<echo message="...saved as ${local.source-normalised}"/>
		
		<!-- Inserts DOCTYPE declaration and drops it in base.out, mirroring the nested path -->
		<sgml:insert-doctype         
			source="${local.source-normalised}"
			doctype="${local.doctype}"
			result="${local.final-output-sgml}"/>
			
		<echo message="...final SGML saved as ${local.final-output-sgml}"/>
	</target>
	
	<target name="all" depends="mkdirs, copy-graphics, loop-empty, loop-charmaps, loop-spam"/>
	
</project>