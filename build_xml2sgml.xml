<?xml version="1.0" encoding="UTF-8"?>
<project
	xmlns:sgml="sgml"	
	basedir="."
	name="xml2sgml" 
	default="all">
	
	<!-- load ant-contrib -->
	<taskdef resource="net/sf/antcontrib/antlib.xml"/>
	
	<tstamp>
		<format property="current.time" pattern="yyyyMMddHHmmss"/>
	</tstamp>
	
	
	<property environment="env"/>
	
	<condition property="isWindows">
		<os family="windows" />
	</condition>
	
	<condition property="isLinux">
		<os family="unix" />
	</condition>
	
	
	<!-- Local properties -->
	<xmlproperty
		file="./build_xml2sgml.properties.local.xml"
		keeproot="false"
		collapseattributes="true"
		semanticattributes="true"/>
	
	<!-- Default properties -->
	<xmlproperty
		file="./build_xml2sgml.properties.xml"
		keeproot="false"
		collapseattributes="true"
		semanticattributes="true"/>
	
	
	<!-- Use module-specific properties -->
	<!-- (We'll only need this if we validate the resulting SGML) -->
	<xmlproperty
		file="${modules}/${current-module}/${current-module}.properties.xml"
		keeproot="false"
		collapseattributes="true"
		semanticattributes="true"/>
	
	<echo message="Current module spec: ${modules}/${current-module}/${current-module}.properties.xml"/>
	
	<taskdef file="${repos.xml2sgml}/ant/antlib.xml" uri="sgml"/>
	
	
	<!-- Create dirs -->
	<target name="mkdirs" description="Create target directories">
		<mkdir dir="${base.tmp}"/>
		<mkdir dir="${base.charmaps}"/>
		<mkdir dir="${base.spam}"/>
		<mkdir dir="${base.doctypes}"/>
		<mkdir dir="${base.expand-empty}"/>
		<mkdir dir="${base.out}"/>
		<mkdir dir="${base.report}"/>
		<mkdir dir="${base.debug}"/>
	</target>


	<target name="copy-graphics" description="Copy any input graphics to the output">
		<mkdir dir="${base.out}"/>
		<copy todir="${base.out}">
			<fileset dir="${base.source}" excludes="*.xml"/>
		</copy>
	</target>
	
	
	<target name="loop-empty" description="Loop the inputs, fix the XML for each">				
		<foreach target="expand-empty" param="file" inheritall="true">
			<path>
				<!-- **/*.xml catches subfolders -->
				<fileset dir="${base.source}">
					<include name="**/*.xml"/>
					<exclude name="build*"/>
				</fileset>
			</path>
		</foreach>
	</target>
	
	
	<target name="expand-empty" description="Expand EMPTY elements, tweak XML">		
		<local name="local.relative-path"/>
		<local name="local.output-filepath"/>
		
		<!-- Extract the relative path of the current file compared to the base source -->
		<pathconvert property="local.relative-path" setonempty="false">
			<path path="${file}"/>
			<map from="${base.source}/" to=""/>
			<map from="${base.source}\" to=""/> <!-- Handles Windows backslashes -->
		</pathconvert>
		
		<!-- Combine the base output dir with the relative path -->
		<property name="local.output-filepath" value="${base.expand-empty}/${local.relative-path}"/>
		
		<!-- Ensure the target subfolder exists before Saxon runs -->
		<dirname property="local.output-dir" file="${local.output-filepath}"/>
		<mkdir dir="${local.output-dir}"/>
		<local name="local.output-dir"/> <!-- Clear local property scope -->
		
		<echo message="Getting rid of XML constructs and expanding EMPTY tags in ${file}"/>
		
		<java
			classname="net.sf.saxon.Transform" 
			fork="yes"
			failonerror="true">
			<classpath>
				<pathelement path="${saxon.jar}"/>
				<pathelement path="${morgana.resolver}"/>
			</classpath>
			<arg line="-catalog:${modules}/${current-module}/catalogs/catalog.xml"/>
			<arg value="-s:${file}"/>
			<arg value="-xsl:${modules.common.xslt.xml2sgml.expand-empty}"/>
			<arg value="-o:${local.output-filepath}"/>
		</java>
		
		<echo message="...saved as ${local.output-filepath}"/>
	</target>
	
	
	<target name="loop-charmaps" description="Loop the inputs, ISO-encode each">
		<foreach target="charmap-xslt" param="file" inheritall="true">
			<path>
				<fileset dir="${base.expand-empty}">
					<include name="*.xml"/>
				</fileset>
			</path>
		</foreach>
	</target>
	
	
	<target name="charmap-xslt" description="Generate DOCTYPE, ISO-encode the input XML">
		<local name="local.source-filename"/>
		<local name="local.output-filepath"/>
		
		<basename property="local.source-filename" file="${file}"/>		
		<property name="local.output-filepath" value="${base.charmaps}/${local.source-filename}"/>
		
		<local name="local.output-doctype"/>
		<property name="local.output-doctype" value="${base.doctypes}/${local.source-filename}"/>
		
		<!-- Generate full DOCTYPE -->
		<java classname="net.sf.saxon.Transform" fork="yes">
			<classpath>
				<pathelement path="${saxon.jar}"/>
				<pathelement path="${morgana.resolver}"/>
			</classpath>
			<arg line="-catalog:${modules}/${current-module}/catalogs/catalog.xml"/>
			<arg value="-s:${file}"/>
			<arg value="-xsl:${modules.common.xslt.xml2sgml.generate-doctype}"/>
			<arg value="-o:${local.output-doctype}"/>
			<arg value="doctype-lookup-uri=${module.schemas.sgml-doctypes}"/>
		</java>              
		
		<echo message="...saved as ${local.output-doctype}"/>
		
		<echo message="Converting ${file} to ISO encoding"/>
		
		<local name="local.dtds"/>
		<makeurl property="local.dtds" file="${modules}/${current-module}/schemas"/>
		
		<java
			classname="net.sf.saxon.Transform" 
			fork="yes"
			failonerror="true">
			<classpath>
				<pathelement path="${saxon.jar}"/>
				<pathelement path="${morgana.resolver}"/>
			</classpath>
			<arg line="-catalog:${modules}/${current-module}/catalogs/catalog.xml"/>
			<arg value="-s:${file}"/>
			<arg value="-xsl:${modules.common.xslt.xml2sgml.iso-encode}"/>
			<arg value="-o:${local.output-filepath}"/>
			<arg value="repos.dtds=${local.dtds}"/>
		</java>
		
		<echo message="...saved as ${local.output-filepath}"/>
	</target>
	
	
	<target name="loop-spam" description="Loop the ISO-encoded files, run spam on each">
		<foreach target="spam" param="file" inheritall="true">
			<path>
				<fileset dir="${base.charmaps}">
					<include name="*.xml"/>
				</fileset>
			</path>
		</foreach>
	</target>
	
	
	<target name="spam" description="Normalise the SGML using spam">
		<local name="local.source-filename"/>
		<local name="local.output-filepath"/>
		
		<basename property="local.source-filename-without-extension" file="${file}" suffix="xml"/>			
		<property
			name="local.doctype"
			location="${base.doctypes}/${local.source-filename-without-extension}.xml"/>
		<property
			name="local.source-with-doctype-xml"
			location="${base.spam}/${local.source-filename-without-extension}.xml"/>
		<property
			name="local.source-normalised"
			location="${base.spam}/${local.source-filename-without-extension}.sgm"/>
		
		
		<sgml:insert-doctype
			source="${file}"
			doctype="${local.doctype}"
			result="${local.source-with-doctype-xml}"/>
		
		<!-- Normalise follows... -->
		
		<echo message="Normalising @{source} using ${module.schemas.input}"/>
		
		<local name="local.source.filename"/>
		<local name="local.source.basename-without-file-extension"/>
		<local name="local.spam-report"/>
		<local name="local.output-dir"/>
		<local name="local.result-property"/>
		
		<basename
			property="local.source.filename"
			file="${local.source-with-doctype-xml}"/>
		<basename
			property="local.source.basename-without-file-extension"
			file="${local.source-with-doctype-xml}"
			suffix="xml"/>
		<property
			name="local.spam-report"
			location="@{spam-report-dir}/${local.source.basename-without-file-extension}.txt"/>
		<dirname
			property="local.output-dir"
			file="${local.source-normalised}"/>
		
		<mkdir dir="${local.spam-report}"/>
		<mkdir dir="${local.output-dir}"/>
		
		<echo message="Spam report to @{spam-report-dir}/${local.source.basename-without-file-extension}.txt"/>
		
		<!-- Set path to spam -->
		<condition property="sp-loc.path.spam" value="${sp-loc.win-path.spam}">
			<isset property="isWindows"/>
		</condition>
		<condition property="sp-loc.path.spam" value="${sp-loc.nix-path.spam}">
			<isset property="isLinux"/>
		</condition>
		
		<echo message="Spam executable (isLinux = ${isLinux}, isWindows = ${isWindows}): ${sp-loc.path.spam}"/>
		
		<exec
			executable="${sp-loc.path.spam}" 
			inputstring="&#10;"
			output="${local.source-normalised}"
			failonerror="false">
			
			<arg value="-E0"/>
			<arg value="-wno-empty"/>
			<arg value="-wno-min-tag"/>
			<arg value="-mreserved"/>
			<arg value="-f${local.spam-report}"/>
			<arg value="-c"/>
			<arg line="${module.schemas.input}"/>
			<arg value="${local.source-with-doctype-xml}"/>
		</exec>
		
		<echo message="...saved as ${local.source-normalised}"/>
		
		<!-- Insert DOCTYPE again because it's not done by spam -->
		<sgml:insert-doctype		 
			source="${local.source-normalised}"
			doctype="${local.doctype}"
			result="${base.out}/${local.source-filename-without-extension}.sgm"/>
	</target>
	
	
	<target name="all" depends="mkdirs, copy-graphics, loop-empty, loop-charmaps, loop-spam"/>
	
</project>