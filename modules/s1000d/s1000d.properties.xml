<?xml version="1.0" encoding="UTF-8"?>
<properties>
    
    <module location="${modules}/s1000d">
        <schemas location="${module}/schemas">
            <!-- SGML -->
            <input location="${module.schemas}/sgml/catalog.txt"/>
            <!-- SGML to XML conversion -->
            <output location="${module.schemas}/sgml/catalog_sgml2xml.txt"/>
            <!-- ATA resources -->
            <resources>
                <ent location="${module.schemas}/sgml/ISOent-declarations-xml.txt"/>
            </resources>
        </schemas>
        
        <!-- Schematron -->
        <sch location="${module}/sch/s1000d-checks.sch"/>
        
        <!-- XProc pipeline manifests and libs -->
        <pipeline>
            <manifest location="${module}/pipelines/s1000d-xslt-manifest.xml"/>
            <xproc location="${module}/xproc/s1000d-migration.xpl"/>
        </pipeline>
    </module>
    
</properties>
