<!--**********************************************************************
    *                                                                    *
    *                     AECMA 1000D Change 8                           *
    *                   Document Type Definition                         *
    *                                                                    *
    *                     Release Version 1.8                            *
    *                   Dated 31st January 1999                          *
    *                                                                    *
    * Amendment :-                                                       *
    * 1. Update Public Identifier                                        *
    * 2. CPF 98-30D Add ID attributes to required elements               *
    *  a. Change attribute entity %INSDEL; to %bodyatt; for elements :-  *
    *      SPECPARA                                                      *
    *                                                                    *
    * Typical invocation :                                               *
    * <!ENTITY % EXTSPEC  PUBLIC                                         *
    *   "-//AECMA//ELEMENTS Special Paragraphs Breakdown 19990131//EN" > *
    * %EXTSPEC;                                                          *
    ********************************************************************** -->



<!--**********************************************************************
    * Define Element SPECPARA containing:-                               *
    *   WARNING - optional   repeatable  contains GRAPHIC, PARA,         *
    *                                    definition stored in entity     *
    *                                    %list;                          *
    *   CAUTION - optional   repeatable  contains GRAPHIC, PARA,         *
    *                                    definition stored in entity     *
    *                                    %list;                          *
    *   NOTE    - optional   repeatable  contains GRAPHIC, PARA,         *
    *                                    definition stored in entity     *
    *                                    %list;                          *
    *   PARA    - mandatory  single      contains definition stored in   *
    *                                    entity %paracon;                *
    *   NOTE    - optional   repeatable  contains GRAPHIC, PARA,         *
    *                                    definition stored in entity     *
    *                                    %list;                          *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  Attribute Definition List stored in entity %bodyatt;              *
    ********************************************************************** -->

<!ELEMENT specpara - o (warning*, caution*, note*, para, note*) >
<!ATTLIST specpara
             %bodyatt; >
<!-- changed %INSDEL; to %bodyatt; -->



<!--**********************************************************************
    * Call the Warning, Caution, Note, Para Public Text.                 *
    * The formal public identifier is stored in the entity %WCNP;        *
    ********************************************************************** -->

%WCNP;
