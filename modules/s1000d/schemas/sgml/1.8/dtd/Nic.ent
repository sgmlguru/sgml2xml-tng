<!--**********************************************************************
    *                                                                    *
    *                     AECMA 1000D Change 8                           *
    *                   Document Type Definition                         *
    *                                                                    *
    *                     Release Version 1.8                            *
    *                   Dated 31st January 1999                          *
    *                                                                    *
    * Amendment :-                                                       *
    * 1. CPF 98-02UK Redefine entity name & public identifier to match   *
    *     elements defined.                                              *
    * 2. CPF 98-30D Add ID attributes to required elements               *
    *  a. Added attribute definition list with %bodyatt; value to        *
    *     elements :-                                                    *
    *      CSNREF                                                        *
    * 3. CPF 98-65D Harmonize MANUFACT & MFC elements to MFC. Harmonize  *
    *      PARTNO & PNR elements to PNR.                                 *
    *                                                                    *
    * Typical invocation :                                               *
    * <!ENTITY % NIC                                                     *
    *   PUBLIC "-//AECMA//ELEMENTS NOMEN, IDENTNO, CSNREF 19990131//EN"  *
    * >                                                                  *
    * %NIC;                                                              *
    ********************************************************************** -->


<!--**********************************************************************
    * Define Element NOMEN (Nomenclature) containing:-                   *
    *  Parsed Character Data.                                            *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    * Attribute Definition list stored in entity %INSDEL;                *
    ********************************************************************** -->

<!ELEMENT nomen - o (#PCDATA) >
<!ATTLIST nomen
            %INSDEL; >



<!--**********************************************************************
    * Define Element IDENTNO (Identification Number) containing:-        *
    *  PNR      - mandatory single       contains Parsed Character Data. *
    *  MFC      - optional  single       contains Parsed Character Data. *
    ********************************************************************** -->

<!ELEMENT identno - o (pnr, mfc?) >
<!ATTLIST identno
            %INSDEL; >
<!-- Change element names for PARTNO to PNR & MANUFACT to MFC -->



<!--**********************************************************************
    * Define Element CSNREF (Reference to CSN) containing:-              *
    *  No Other Tags.                                                    *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  REFCSN   - CDATA  - REQUIRED - CSN code                           *
    *  REFISN   - CDATA  - IMPLIED  - ISN code                           *
    ********************************************************************** -->
 
<!ELEMENT csnref  - O  EMPTY >
<!ATTLIST csnref
             refcsn  CDATA    #REQUIRED
             refisn  CDATA    #IMPLIED
             %bodyatt; >
<!-- Added entity %bodyatt; to attribute definition list -->