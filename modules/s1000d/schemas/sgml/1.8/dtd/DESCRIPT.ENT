<!--**********************************************************************
    *                                                                    *
    *                     AECMA 1000D Change 8                           *
    *                   Document Type Definition                         *
    *                                                                    *
    *                     Release Version 1.8                            *
    *                   Dated 31st January 1999                          *
    *                                                                    *
    * Amendment :-                                                       *
    * 1. Update Public Identifier.                                       *
    * 2. CPF ??-?? Remove descriptive caption elements and harmonize     *
    *     with Aircrew caption elements                                  *
    *  a. Remove CTEXT, CAPTION, BRK elements.                           *
    *  b. New entity reference to caption group entity.                  *
    *  c. Add element capgrp in place to ctext, caption, brk, graphic    *
    *      within entity %HEADING;                                       *
    *                                                                    *
    * Typical invocation :                                               *
    * <!ENTITY % DESCRPT                                                 *
    *   PUBLIC "-//AECMA//ELEMENTS Description Breakdown 19990131//EN" > *
    * %DESCRPT;                                                          *
    ********************************************************************** -->



<!--**********************************************************************
    * Define Entity %CONTENT (Content Breakdown) containing :- DESCRIP   *
    ********************************************************************** -->

<!ENTITY % CONTENT "descript" >



<!--**********************************************************************
    * Define Element DESCRIP (Descriptive Content) containing :-         *
    *  PARA     - optional  repeatable contains definition stored in     *
    *                                  entity %paracon;                  *
    *  Definition stored in entity %spcpara;                             *
    *  PARA0    - optional  repeatable contains definition stored in     *
    *                                  entity %nparcon; %SUBPAR1;.       *
    **********************************************************************
    * INCLUSION : Figure, Foldout, Table, Caption.                       *
    ********************************************************************** -->

<!ELEMENT descript - o (para*,(%spcpara;),para0*)
              +(figure | foldout | table | caption) >



<!-- Delete elements caption, ctext brk -->



<!--**********************************************************************
    * Define Entity %HEADING; (Numbered Paragraphs Heading) containing:- *
    *  APPLIC   - optional   single      contains TYPE, MODEL.           *
    *  TITLE    - optional   single      contains definition stored in   *
    *                                    entity %text;                   *
    *  CAPGRP   - optional   single      contains COLSPEC, SPANSPEC,     *
    *                                     CAPBODY.                       *
    ********************************************************************** -->

<!ENTITY % HEADING "applic?, title?, capgrp?" >
<!-- Replace caption, ctext, brk, graphic with capgrp -->



<!--**********************************************************************
    * Call the Caption Group Public Text.                                *
    * The formal public identifier is stored in the entity %CAPGRP;      *
    ********************************************************************** -->

%CAPGRP;



<!--**********************************************************************
    * Call the Numbered Paragraphs Public Text.                          *
    * The formal public identifier is stored in the entity %EXTPARA;     *
    ********************************************************************** -->

%EXTPARA;



<!--**********************************************************************
    * Call the Lists Public Text.                                        *
    * The formal public identifier is stored in the entity %EXTLIST;     *
    ********************************************************************** -->

%EXTLIST;



<!--**********************************************************************
    * Call the Figure And Table Public Text.                             *
    * The formal public identifier is stored in the entity %EXTFTAB;     *
    ********************************************************************** -->

%EXTFTAB;



<!--**********************************************************************
    * Call the Special Paragraphs Public Text.                           *
    * The formal public identifier is stored in the entity %EXTSPEC;     *
    ********************************************************************** -->

%EXTSPEC;
