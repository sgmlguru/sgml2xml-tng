<!--**********************************************************************
    *                                                                    *
    *                     AECMA 1000D Change 8                           *
    *                   Document Type Definition                         *
    *                                                                    *
    *                     Release Version 1.8                            *
    *                   Dated 31st January 1999                          *
    *                                                                    *
    * Amendment :-                                                       *
    * 1. Redefinition of entity %NCII; to %NIC;                          *
    * 2. CPF 98-30D Add ID attributes to required elements               *
    *  a. Change attribute entity %INSDEL; to %bodyatt; for elements :-  *
    *      ESTTIME, PERSCAT, PERSKILL, PERSON, TRADE                     *
    *  b. Added attribute definition list with %bodyatt; value to        *
    *     elements :-                                                    *
    *      REQDM, REQPERS, REQTP                                         *
    *  c. Added ID attribute to elements :-                              *
    *      SAFECOND                                                      *
    * 3. CPF 98-33F Move PMD to first element within PRELREQS.           *
    * 4. CPF 99-01UK Restucture Required conditions, deleted element     *
    *      DMANDTP.                                                      *
    * 5. CPF 98-59UK Change SKILL element to EMPTY, and add the attribute*
    *     SKILL from the PERSKILL element.                               *
    * 6. CPF 98-65D Harmonize MANUFACT & MFC element to MFC, QUANTITY &  *
    *     QTY to QTY.                                                    *
    * 7. CPF 98-54UK Restructure to single applicability for both AVEE   *
    *     & AGE                                                          *
    *  a. Removal of entity %NSN;                                        *
    * 8. CPF 99-36D                                                      *
    *  a. Change content model of QTY to parsed character data.          *
    *  b. Deleted attribute QTY from element QTY.                        *
    *  c. Added attribute UOM to element QTY.                            *
    *                                                                    *
    * Typical invocation :                                               *
    * <!ENTITY % PRELREQ                                                 *
    *   PUBLIC "-//AECMA//ELEMENTS Preliminary Requirements 19990131//EN"*
    * >                                                                  *
    * %PRELREQ;                                                          *
    ********************************************************************** -->



<!--**********************************************************************
    * Define Element PRELREQS (Preliminary Requirements) containing:-    *
    *  PMD      - optional   single      contains THI, ZONE, ACCPNL,     *
    *                                     AVEHCFG, OPNDURN.              *
    *  REQCONDS - mandatory  single      contains NOCONDS, REQCOND,      *
    *                                    REQCONDM, REQCONTP.             *
    *  REQPERS  - optional   single      contains ASREQUIR, PERSON,      *
    *                                     PERSCAT, PERSKILL, TRADE,      *
    *                                     ESTTIME.                       *
    *  SUPEQUIP - mandatory  single      contains NOSUPEQ, SUPEQLI.      *
    *  SUPPLIES - mandatory  single      contains NOSUPPLY, SUPPLY.      *
    *  SPARES   - mandatory  single      contains NOSPARES, SPARESLI.    *
    *  SAFETY   - mandatory  single      contains NOSAFETY, SAFECOND.    *
    ********************************************************************** -->

<!ELEMENT prelreqs - o (pmd?, reqconds, reqpers?, supequip, supplies, spares,
                        safety) >
<!-- Move PMD from status to prelreqs -->



<!--**********************************************************************
    * Call the Product Management data Public Text.                      *
    * The formal public identifier is stored in the entity %PMDATA;      *
    ********************************************************************** -->

%PMDATA;



<!--**********************************************************************
    * Define Element REQCONDS (Required Conditions) containing:-         *
    *  NOCONDS  - mandatory  single      contains No Other Tags.         *
    * or                                                                 *
    *--------------------------------------------------------------------*
    * Mandatory Repeatable Group                                         *
    *--------------------------------------------------------------------*
    *  REQCOND  - mandatory  single      contains definition stored in   *
    *                                    entity %text;                   *
    * or                                                                 *
    *  REQCONDM - mandatory  single      contains REQCOND, REQDM.        *
    * or                                                                 *
    *  REQCONTP - mandatory  single      contains REQCOND, REQTP.        *
    *--------------------------------------------------------------------*
    ********************************************************************** -->

<!ELEMENT reqconds - o (noconds | (reqcond | reqcondm | reqcontp)+) >
<!-- Restructure reqconds -->


<!--**********************************************************************
    * Define Element NOCONDS (No Required Conditions) containing:-       *
    *   No Other Tags.                                                   *
    ********************************************************************** -->

<!ELEMENT noconds - o EMPTY >



<!-- Deleted DMANDTP element -->



<!--**********************************************************************
    * Define Element REQCONDM (Required Condition Data Modules)          *
    * containing :-                                                      *
    *--------------------------------------------------------------------*
    * Mandatory Repeatable Group                                         *
    *--------------------------------------------------------------------*
    *  REQCOND   - mandatory single     contains definition stored in    *
    *                                   entity %text;                    *
    *  REQDM     - mandatory single     contains definition stored in    *
    *                                   entity %ALLDMC;                  *
    *--------------------------------------------------------------------*
    ********************************************************************** -->

<!ELEMENT reqcondm - o (reqcond,reqdm)+ >



<!--**********************************************************************
    * Define Element REQCOND (Required Condition) containing:-           *
    *--------------------------------------------------------------------*
    * Mandatory Repeatable Group.                                        *
    *--------------------------------------------------------------------*
    *  Definition stored in entity %text;                                *
    *--------------------------------------------------------------------*
    **********************************************************************
    * EXCLUSION : REFDM, REFTP.                                          *
    ********************************************************************** -->

<!ELEMENT reqcond - o (%text;)+  -(refdm | reftp)>



<!--**********************************************************************
    * Define Element REQDM (Required Data Module) containing:-           *
    *  Definition stored in entity %ALLDMC;                              *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  Attribute Definition list stored in entity %bodyatt;              *
    ********************************************************************** -->

<!ELEMENT reqdm - o (%ALLDMC;) >
<!ATTLIST reqdm
            %bodyatt; >
<!-- Added attribute list to reqdm element -->



<!--**********************************************************************
    * Define Element REQCONTP (Required Condition Technical Publications)*
    * containing:-                                                       *
    *--------------------------------------------------------------------*
    * Mandatory Repeatable Group.                                        *
    *--------------------------------------------------------------------*
    *  REQCOND   - mandatory single     contains definition stored in    *
    *                                   entity %text;                    *
    *  REQTP     - mandatory single     contains definition stored in    *
    *                                   entity %text;                    *
    *--------------------------------------------------------------------*
    ********************************************************************** -->

<!ELEMENT reqcontp - o (reqcond,reqtp)+ >



<!--**********************************************************************
    * Define Element REQTP (Required Technical Publication) containing:- *
    *--------------------------------------------------------------------*
    * Mandatory Repeatable Group.                                        *
    *--------------------------------------------------------------------*
    *  Definition stored in entity %text;                                *
    *--------------------------------------------------------------------*
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  Attribute Definition list stored in entity %bodyatt;              *
    **********************************************************************
    * EXCLUSION : REFDM, REFTP.                                          *
    ********************************************************************** -->

<!ELEMENT reqtp - o (%text;)+  -(refdm | reftp) >
<!ATTLIST reqtp
            %bodyatt; >
<!-- Added attribute list to reqtp element -->



<!--**********************************************************************
    * Define Element REQPERS (Required Persons) containing:-             *
    *--------------------------------------------------------------------*
    * Mandatory Repeatable Group.                                        *
    *--------------------------------------------------------------------*
    *++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++*
    *  ASREQUIR  - mandatory single     contains No Other Tags.          *
    * or                                                                 *
    *  PERSON    - mandatory single     contains No Other Tags.          *
    *++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++*
    *====================================================================*
    * Optional Single Group                                              *
    *====================================================================*
    *  PERSCAT   - mandatory single     contains No Other Tags.          *
    *  PERSKILL  - optional  single     contains No Other Tags.          *
    *  TRADE     - optional  single     contains Parsed Character Data.  *
    *  ESTTIME   - optional  single     contains Parsed Character Data.  *
    *====================================================================*
    *--------------------------------------------------------------------*
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  Attribute Definition list stored in entity %bodyatt;              *
    ********************************************************************** -->

<!ELEMENT reqpers - o  ((asrequir | person),
                          (perscat,perskill?,trade?,esttime?)?)+  >
<!ATTLIST reqpers
            %bodyatt; >
<!-- Added attribute list to reqpers element -->



<!--**********************************************************************
    * Define Element ASREQUIR  (As Required) containing:-                *
    *  No Other Tags.                                                    *
    ********************************************************************** -->

<!ELEMENT asrequir - o EMPTY >



<!--**********************************************************************
    * Define Element PERSON  (Personnel) containing:-                    *
    *  No Other Tags.                                                    *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  MAN      - NMTOKEN  - REQUIRED - Man identifier.                  *
    * Attribute Definition list stored in entity %bodyatt;               *
    ********************************************************************** -->

<!ELEMENT person - o EMPTY>
<!ATTLIST person
             man NMTOKEN #REQUIRED
             %bodyatt; >
<!-- changed %INSDEL; to %bodyatt; -->



<!--**********************************************************************
    * Define Element PERSCAT  (Personnel Category) containing:-          *
    *  No Other Tags.                                                    *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  CATEGORY - DECLARED - REQUIRED - Personnel category of required   *
    *                                   trade to complete the task.      *
    *             Definition stored in entity %CATEG;                    *
    * Attribute Definition list stored in entity %bodyatt;               *
    ********************************************************************** -->

<!ELEMENT perscat - o EMPTY >
<!ATTLIST perscat
            category %CATEG; #REQUIRED
            %bodyatt; >
<!-- changed %INSDEL; to %bodyatt; -->



<!-- Moved entity declaration %SKILL; to AECMA configuration -->



<!--**********************************************************************
    * Define Element PERSKILL  (Personnel Skill Level) containing:-      *
    *  No Other Tags.                                                    *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  SKILL    - DECLARED - REQUIRED - Personnel skill level            *
    *             Definition stored in entity %SKILL;                    *
    * Attribute Definition list stored in entity %bodyatt;               *
    ********************************************************************** -->

<!ELEMENT perskill - o EMPTY>
<!ATTLIST perskill
             skill %SKILL; #REQUIRED
             %bodyatt; >
<!-- changed %INSDEL; to %bodyatt; -->



<!--**********************************************************************
    * Define Element TRADE (Personnel Trade Code) containing:-           *
    *  Parsed Character Data.                                            *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    * Attribute Definition list stored in entity %bodyatt;               *
    ********************************************************************** -->

<!ELEMENT trade - o (#PCDATA) >
<!ATTLIST trade
             %bodyatt; >
<!-- changed %INSDEL; to %bodyatt; -->



<!--**********************************************************************
    * Define Element ESTTIME (Estimated Time Spent) containing:-         *
    *  Parsed Character Data.                                            *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  Attribute Definition list stored in entity %bodyatt;              *
    ********************************************************************** -->

<!ELEMENT esttime - o (#PCDATA) >
<!ATTLIST esttime
             %bodyatt; >
<!-- changed %INSDEL; to %bodyatt; -->



<!--**********************************************************************
    * Define Element SUPEQUIP (Support Equipment) containing:-           *
    *  NOSUPEQ  - mandatory single       contains No Other Tags.         *
    * or                                                                 *
    *  SUPEQLI  - mandatory single       contains SUPEQUI.               *
    ********************************************************************** -->

<!ELEMENT supequip - o (nosupeq | supeqli) >



<!--**********************************************************************
    * Define Element NOSUPEQ (No Support Equipment) containing:-         *
    *  No Other Tags.                                                    *
    ********************************************************************** -->

<!ELEMENT nosupeq - o EMPTY >



<!--**********************************************************************
    * Define Element SUPEQLI (Support Equipment List) containing:-       *
    *  SUPEQUI  - mandatory repeatable   contains NOMEN, NSN, IDENTNO,   *
    *                                    CSNREF, QTY.                    *
    ********************************************************************** -->

<!ELEMENT supeqli - o (supequi+) >
<!-- changed Quantity to Qty -->



<!--**********************************************************************
    * Define Element SUPEQUI (Support Equipment Item) containing:-       *
    *  NOMEN    - mandatory single       contains Parsed Character Data. *
    *  NSN      - optional  single       contains no other tags.         *
    *--------------------------------------------------------------------*
    * Mandatory Repeatable Group                                         *
    *--------------------------------------------------------------------*
    *  IDENTNO  - mandatory single       contains PNR, MFC.              *
    * or                                                                 *
    *  CSNREF   - mandatory single       contains no other tags.         *
    *--------------------------------------------------------------------*
    *  QTY      - mandatory single       contains Parsed Character Data. *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  Attribute Definition list stored in entity %bodyatt;              *
    ********************************************************************** -->

<!ELEMENT supequi - o (nomen, nsn?, (identno | csnref)+, qty) >
<!ATTLIST supequi
             %bodyatt; >
<!-- changed Quantity to Qty -->



<!--**********************************************************************
    * Call the NOMEN, IDENTNO, CSNREF Public Text.                       *
    * The formal public identifier is stored in the entity %NIC;         *
    ********************************************************************** -->

%NIC;
<!-- Changed entity reference from %NCII; to %NIC; -->



<!-- Removal of entity %NSN; -->


<!-- Delete element Quantity and moved defintion of element Qty from
     Schedul.ent to Prelreq.ent  -->

<!--**********************************************************************
    * Define Element Qty (Quantity) containing:-                         *
    *   Parsed Character Data                                            *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  UOM    - CDATA  - IMPLIED - Unit of measure.                      *
    *  Attribute Definition list stored in entity %INSDEL;               *
    ********************************************************************** -->

<!ELEMENT qty  - O  (#PCDATA) >
<!ATTLIST qty
            uom  CDATA #IMPLIED
            %INSDEL;  >
<!-- Changed content model, delete attribute qty, added attribute uom -->



<!--**********************************************************************
    * Define Element SUPPLIES (Supplies) containing:-                    *
    *  NOSUPPLY - mandatory  single      contains No Other Tags.         *
    * or                                                                 *
    *  SUPPLYLI - mandatory  single      contains SUPPLY.                *
    ********************************************************************** -->

<!ELEMENT supplies - o (nosupply | supplyli) >



<!--**********************************************************************
    * Define Element NOSUPPLY (No Supplies) containing:-                 *
    *  No Other Tags.                                                    *
    ********************************************************************** -->

<!ELEMENT nosupply - o EMPTY >



<!--**********************************************************************
    * Define Element SUPPLYLI (Supplies List) containing:-               *
    *  SUPPLY   - mandatory repeatable   contains NOMEN, NSN, IDENTNO,   *
    *                                    CSNREF, QTY.                    *
    ********************************************************************** -->

<!ELEMENT supplyli - o (supply+)>
<!-- changed Quantity to Qty -->



<!--**********************************************************************
    * Define Element SUPPLY (Supply Item) containing:-                   *
    *  NOMEN    - mandatory single       contains Parsed Character Data. *
    *  NSN      - optional  single       contains no other tags.         *
    *--------------------------------------------------------------------*
    * Mandatory Repeatable Group                                         *
    *--------------------------------------------------------------------*
    *  IDENTNO  - mandatory single       contains PNR, MFC.              *
    * or                                                                 *
    *  CSNREF   - mandatory single       contains no other tags.         *
    *--------------------------------------------------------------------*
    *  QTY      - mandatory  single      contains Parsed Character Data  *
    ********************************************************************** -->

<!ELEMENT supply - o (nomen, nsn?, (identno | csnref)+, qty) >
<!ATTLIST supply
             %bodyatt; >
<!-- changed Quantity to Qty -->



<!--**********************************************************************
    * Define Element SPARES (Spares) containing:-                        *
    *  NOSPARES - mandatory  single      contains No Other Tags.         *
    * or                                                                 *
    *  SPARESLI - mandatory  single      contains SPARE.                 *
    ********************************************************************** -->

<!ELEMENT spares - o (nospares | sparesli) >



<!--**********************************************************************
    * Define Element NOSPARES (No Spares) containing:-                   *
    *  No Other Tags.                                                    *
    ********************************************************************** -->

<!ELEMENT nospares - o EMPTY >



<!--**********************************************************************
    * Define Element SUPPLYLI (Supplies List) containing:-               *
    *  SPARE    - mandatory repeatable   contains NOMEN, NSN, IDENTNO,   *
    *                                    CSNREF, QTY.                    *
    ********************************************************************** -->

<!ELEMENT sparesli - o (spare+) >
<!-- changed Quantity to Qty -->



<!--**********************************************************************
    * Define Element SPARE (Spares Item) containing:-                    *
    *  NOMEN    - mandatory single       contains Parsed Character Data. *
    *  NSN      - optional  single       contains no other tags.         *
    *--------------------------------------------------------------------*
    * Mandatory Repeatable Group                                         *
    *--------------------------------------------------------------------*
    *  IDENTNO  - mandatory single       contains PNR, MFC.              *
    * or                                                                 *
    *  CSNREF   - mandatory single       contains no other tags.         *
    *--------------------------------------------------------------------*
    *  QTY      - mandatory  single      contains Parsed Character Data. *
    ********************************************************************** -->

<!ELEMENT spare - o (nomen, nsn?, (identno | csnref)+, qty) >
<!ATTLIST spare
             %bodyatt; >
<!-- changed Quantity to Qty -->



<!--**********************************************************************
    * Define Element SAFETY (Safety Conditions) containing:-             *
    *  NOSAFETY - mandatory  single      contains No Other Tags.         *
    * or                                                                 *
    *  SAFECOND - mandatory  single      contains definition stored in   *
    *                                    entity %spcpara;                *
    ********************************************************************** -->

<!ELEMENT safety - o (nosafety | safecond) >



<!--**********************************************************************
    * Define Element NOSAFETY (No Safety Conditions) containing:-        *
    *  No Other Tags.                                                    *
    ********************************************************************** -->

<!ELEMENT nosafety - o EMPTY >



<!--**********************************************************************
    * Define Element SAFECOND (Safety Condition) containing:-            *
    *  Definition stored in entity %spcpara;                             *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  ID       - ID       - IMPLIED - Unique identifier of safety       *
    *                                   conditions                       *
    ********************************************************************** -->

<!ELEMENT safecond - o (%spcpara;) >
<!ATTLIST safecond
            id    ID  #IMPLIED >
<!-- Added attribute list to safecond element -->
