<!--**********************************************************************
    *                                                                    *
    *                     AECMA 1000D Change 8                           *
    *                   Document Type Definition                         *
    *                                                                    *
    *                     Release Version 1.8                            *
    *                   Dated 31st January 1999                          *
    *                                                                    *
    * Amendment :-                                                       *
    * 1. Update Public Identifier                                        *
    * 2. CPF 98-30D Add ID attributes to required elements               *
    *  a. Change attribute entity %INSDEL; to %bodyatt; for elements :-  *
    *      CHANGE                                                        *
    *  b. Added ID attribute to elements :-                              *
    *      GRAPHIC, SYMBOL                                               *
    * 3. CPF 99-14UK Add value PARA & STEPS to list of declared values on*
    *      the XREF element, remove declared value TEXT.                 *
    * 4. CPF 98-??? Harmonize Caption handling, Also allow captions in   *
    *     AVEE Descriptive & Procedural.                                 *
    *   a. Added entity declaration & entity reference to %CAPPCON;      *
    * 6. CPF 98-58UK Add value UNDERSRC to list of declared values for   *
    *     EMPHASIS.                                                      *
    * 7. CPF ??-?? Add tiff image notation.                              *
    *                                                                    *
    * Typical invocation :                                               *
    * <!ENTITY % COMMON                                                  *
    *   PUBLIC "-//AECMA//ENTITIES Common Entities 19990131//EN" >       *
    * %COMMON;                                                           *
    ********************************************************************** -->



<!--**********************************************************************
    * Define the cgm Notation, to the Public Identifier for CGM          *
    * graphics.                                                          *
    ********************************************************************** -->

<!NOTATION cgm PUBLIC
"-//USA-DOD//NOTATION Computer Graphics Metafile//EN" >



<!--**********************************************************************
    * Define the fax Notation, to the Public Identifier for CCITT Group 4*
    * images.                                                            *
    ********************************************************************** -->

<!NOTATION fax PUBLIC
"-//USA-DOD//NOTATION CCITT Group 4 Facsimile//EN" >



<!--**********************************************************************
    * Define the JPEG Notation, to the Public Identifier for JPEG        *
    * images.                                                            *
    ********************************************************************** -->

<!NOTATION JPEG PUBLIC
"+//ISBN 0-7923-9432-1::Graphic Notation//NOTATION Joint Photographic Experts Group Raster//EN" >



<!--**********************************************************************
    * Define the tiff Notation, to the Public Identifier for TIFF        *
    * images.                                                            *
    ********************************************************************** -->

<!NOTATION tiff PUBLIC
 "-//Aldus/Microsoft Tagged Interchange File Format//NOTATION CCITT Group 4 Facsimile//EN" >
<!-- Added tiff notation -->


<!--**********************************************************************
    * Call the ISO Added Latin 1 Public Text. The formal public          *
    * identifier is stored in the entity %ISOlat1;                       *
    ********************************************************************** -->

%ISOlat1;



<!--**********************************************************************
    * Call the ISO Publishing Public Text. The formal public identifier  *
    * is stored in the entity %ISOpub;                                   *
    ********************************************************************** -->

%ISOpub;



<!--**********************************************************************
    * Call the ISO Greek Symbols Public Text. The formal public          *
    * identifier is stored in the entity %ISOgrk3;                       *
    ********************************************************************** -->

%ISOgrk3;



<!--**********************************************************************
    * Call the ISO Numeric and Special Symbols Public Text. The formal   *
    * public identifier is stored in the entity %ISOnum;                 *
    ********************************************************************** -->

%ISOnum;



<!--**********************************************************************
    * Call the ISO General Technical Public Text. The formal public      *
    * identifier is stored in the entity %ISOtech;                       *
    ********************************************************************** -->

%ISOtech;



<!--**********************************************************************
    * Define Entity %yesorno (Yes or No Attribute Answer) containing:-   *
    * NUMBER                                                             *
    ********************************************************************** -->

<!ENTITY % yesorno  "NUMBER" >



<!--**********************************************************************
    * Define Entity %spcpara; (Special Paragraphs) containing:-          *
    *  WARNING  - optional   repeatable  contains GRAPHIC, PARA, %list;  *
    *  CAUTION  - optional   repeatable  contains GRAPHIC, PARA, %list;  *
    *  NOTE     - optional   repeatable  contains GRAPHIC, PARA, %list;  *
    ********************************************************************** -->

<!ENTITY % spcpara "(warning* , caution* , note*)" >



<!--**********************************************************************
    * Define Entity %ACTEXT; (AirCrew Running Text Continuation)         *
    * containing:                                                        *
    *  No Information                                                    *
    ********************************************************************** -->

<!ENTITY % ACTEXT "" >



<!--**********************************************************************
    * Define Entity %text (Running Text) containing:-                    *
    *   Parsed Character Data.                                           *
    *  or                                                                *
    *   XREF     - mandatory single     contains No Other Tags.          *
    *  or                                                                *
    *   INDXFLAG - mandatory single     contains No Other Tags.          *
    *  or                                                                *
    *   CHANGE   - mandatory single     contains definition stored in    *
    *                                   entity %text;                    *
    *  or                                                                *
    *   EMPHASIS - mandatory single     contains definition stored in    *
    *                                   entity %text;                    *
    *  or                                                                *
    *   SYMBOL   - mandatory single     contains No Other Tags.          *
    *  or                                                                *
    *   SUBSCRPT - mandatory single     contains Replaceable Character   *
    *                                   Data.                            *
    *  or                                                                *
    *   SUPSCRPT - mandatory single     contains Replaceable Character   *
    *                                   Data.                            *
    *  or                                                                *
    *   REFDM    - mandatory single     contains definition stored in    *
    *                                   entity %ALLDMC;                  *
    *  or                                                                *
    *   REFTP    - mandatory single     contains TECHPUB.                *
    * Definition stored in entity %ACPCON;                               *
    ********************************************************************** -->

<!ENTITY % text "(#PCDATA | xref | indxflag | change | emphasis | symbol
                  | subscrpt | supscrpt | refdm | reftp  %ACTEXT;)" >



<!--**********************************************************************
    * Define Element XREF (Cross Reference) containing:-                 *
    *  No Other Tags.                                                    *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  XREFID   - IDREF    - REQUIRED - Cross reference ID.              *
    *  XIDTYPE  - DECLARED - REQUIRED - Type of ID.                      *
    *           - "FIGURE"   - Cross reference to a figure.              *
    *           - "TABLE"    - Cross reference to a table.               *
    *           - "SUPPLY"   - Cross reference to Supply.                *
    *           - "SUPEQUIP" - Cross reference to Support Equipment.     *
    *           - "SPARES"   - Cross reference to Spares.                *
    *  PRETEXT  - CDATA    - IMPLIED  - Text that will precede the cross *
    *                                   reference.                       *
    *  POSTTEXT - CDATA    - IMPLIED  - Text that will follow the cross  *
    *                                   reference.                       *
    ********************************************************************** -->

<!ELEMENT xref - o EMPTY >
<!ATTLIST xref
             xrefid   IDREF  #REQUIRED
             xidtype (figure | table | supply | supequip | spares | para |
                      step)  #REQUIRED
             pretext  CDATA  #IMPLIED
             posttext CDATA  #IMPLIED >
<!-- Added para & steps declared value, remove text declared value -->



<!--**********************************************************************
    * Define Element INDXFLAG (Index Flag) containing:-                  *
    *  No Other Tags.                                                    *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  REF1     - CDATA    - IMPLIED  - First level reference.           *
    *  REF2     - CDATA    - IMPLIED  - Second level reference.          *
    *  REF3     - CDATA    - IMPLIED  - Third level reference.           *
    *  REF4     - CDATA    - IMPLIED  - Fourth level reference.          *
    ********************************************************************** -->

<!ELEMENT indxflag - o EMPTY >
<!ATTLIST indxflag
            ref1 CDATA #IMPLIED
            ref2 CDATA #IMPLIED
            ref3 CDATA #IMPLIED
            ref4 CDATA #IMPLIED >



<!--**********************************************************************
    * Define Element CHANGE (Change Marker) containing:-                 *
    *--------------------------------------------------------------------*
    * Mandatory Repeatable Group.                                        *
    *--------------------------------------------------------------------*
    *   Definition stored in entity %text;                               *
    *--------------------------------------------------------------------*
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    * Attribute Definition List stored in entity %bodyatt;               *
    ********************************************************************** -->

<!ELEMENT change - - ((%text;)+) >
<!ATTLIST change
            %bodyatt; >
<!-- changed %INSDEL; to %bodyatt; -->



<!--**********************************************************************
    * Define Element EMPHASIS (Phrase Emphasis) containing:-             *
    *--------------------------------------------------------------------*
    * Mandatory Repeatable Group.                                        *
    *--------------------------------------------------------------------*
    *  Definition stored in entity %text;                                *
    *--------------------------------------------------------------------*
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  EMPH     - DECLARED - "BOLD"   - Names identifying the type of    *
    *                                   emphasis.                        *
    *           - BOLD     - Bold typeface.                              *
    *           - ITALIC   - Italic typeface.                            *
    *           - UNDERSRC - Underscore typeface.                        *
    ********************************************************************** -->

<!ELEMENT emphasis - - ((%text;)+) >
<!ATTLIST emphasis
            emph (Bold | Italic | Undersrc) "Bold" >
<!-- Added Undersrc declared value -->


<!--**********************************************************************
    * Define Element SYMBOL (Symbol) containing:-                        *
    *  No Other Tags.                                                    *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  BOARDNO  - ENTITY   - REQUIRED - Unique graphic identifier.       *
    *  ID       - ID       - IMPLIED  - Unique identifier of symbol      *
    ********************************************************************** -->

<!ELEMENT symbol - o EMPTY >
<!ATTLIST symbol
              boardno     ENTITY       #REQUIRED
              id          ID           #IMPLIED  >
<!-- Added id attribute to attribute definition list -->



<!--**********************************************************************
    * Define Element GRAPHIC (Graphic / Image) containing:-              *
    *  No Other Tags.                                                    *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  BOARDNO  - ENTITY   - REQUIRED - Unique graphic identifier.       *
    *  ID       - ID       - IMPLIED  - Unique identifier of graphic     *
    ********************************************************************** -->

<!ELEMENT graphic - o EMPTY >
<!ATTLIST graphic
              boardno     ENTITY       #REQUIRED
              id          ID           #IMPLIED >
<!-- Added id attribute to attribute definition list -->



<!--**********************************************************************
    * Define Elements SUBSCRPT (Sub Script) & SUPSCRPT (Super Script)    *
    * containing:-                                                       *
    *  Replaceable Character Data.                                       *
    ********************************************************************** -->

<!ELEMENT (subscrpt | supscrpt) - - RCDATA >



<!--**********************************************************************
    * Define Entity %titles (Title Structure) containing:-               *
    *  APPLIC   - optional   single      contains TYPE, MODEL.           *
    *  TITLE    - mandatory  single      contains definition stored in   *
    *                                    entity %text;                   *
    ********************************************************************** -->

<!ENTITY % titles "(applic?,title)" >



<!--**********************************************************************
    * Define Element Title (Title) containing:-                          *
    *  Definition stored in entity %text;                                *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    * Attribute Definition List stored in entity %secur;                 *
    ********************************************************************** -->

<!ELEMENT title - o ((%text;)+) -(figure | foldout | table) >
<!ATTLIST title
             %secur; >



<!--**********************************************************************
    * Define Entity %list; (Types Of Lists) containing:-                 *
    *  SEQLIST  - mandatory  single      contains TITLE, ITEM.           *
    * or                                                                 *
    *  RANDLIST - mandatory  single      contains TITLE, ITEM.           *
    * or                                                                 *
    *  DEFLIST  - mandatory  single      contains TITLE, TERM, DEF.      *
    ********************************************************************** -->

<!ENTITY % list "(seqlist | randlist | deflist)" >



<!--**********************************************************************
    * Define Entity %CAPPCON; (Caption Paragraphc Continuation)          *
    * containing:                                                        *
    *  No Information                                                    *
    ********************************************************************** -->

<!ENTITY % CAPPCON "" >
<!-- Added entity declaration for %CAPPCON; -->



<!--**********************************************************************
    * Define Entity %paracon; (Paragraph Continuation) containing:-      *
    *--------------------------------------------------------------------*
    * Mandatory Repeatable Group.                                        *
    *--------------------------------------------------------------------*
    *  Definition stored in entity %text;                                *
    * or                                                                 *
    *  Definition stored in entity %list;                                *
    *--------------------------------------------------------------------*
    ********************************************************************** -->

<!ENTITY % paracon "(%text; | %list; %CAPPCON;)+" >
<!-- Added %CAPPCON; entity reference -->
