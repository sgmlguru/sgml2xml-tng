<!--**********************************************************************
    *                                                                    *
    *                     AECMA 1000D Change 8                           *
    *                   Document Type Definition                         *
    *                                                                    *
    *                     Release Version 1.8                            *
    *                   Dated 31st January 1999                          *
    *                                                                    *
    * Amendment :-                                                       *
    * 1. CPF ??-?? Remove descriptive caption elements and harmonize with*
    *  Aircrew caption elements                                          *
    *  a. New Public Identifier for caption group.                       *
    *  b. Extracted Caption Group elements from Aircrew content entity.  *
    * 2. CPF 98-30D Add ID attributes to required elements               *
    *  a. Change attribute entity %INSDEL; to %bodyatt; for elements :-  *
    *      CAPGRP, CAPROW                                                *
    * 3. CPF 98-63D Add type attribute to caption                        *
    *                                                                    *
    * Typical invocation :                                               *
    * <!ENTITY % CAPGRP                                                  *
    *   PUBLIC "-//AECMA//ELEMENTS Caption Group 19990131//EN" >         *
    * %CAPGRP;                                                           *
    ********************************************************************** -->



<!--**********************************************************************
    * Define Element CAPGRP (Caption Group) containing:-                 *
    *  COLSPEC  - optional   repeatable  contains No Other Tags.         *
    *  SPANSPEC - optional   repeatable  contains No Other Tags.         *
    *  CAPBODY  - mandatory  single      contains CAPROW.                *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):                                                      *
    *  COLS     - NUMBER   - REQUIRED - Number of columns in caption     *
    *                                    group                           *
    *  ALIGN    - Declared - "LEFT"   - Align Caption Group              *
    *           - "LEFT"   - Quad (flush) left.                          *
    *           - "CENTER" - Centered.                                   *
    *           - "RIGHT"  - Quad (flush) right.                         *
    *  TOCTYPE  - Declared - "NONE"   - Identifies the appropriate Table *
    *                                   of Contents                      *
    * Attribute Definition list stored in entity %bodyatt;               *
    *  COLSEP   - NUMBER   - IMPLIED  - Internal Column rulings.         *
    *           - "0"      - Do Not display internal column rulings.     *
    *           - "1"      - Display internal column rulings.            *
    *  ROWSEP   - NUMBER   - IMPLIED  - Internal Row rulings.            *
    *           - "0"      - Do Not display internal row rulings.        *
    *           - "1"      - Display internal row rulings.               *
    ********************************************************************** -->

<!ELEMENT capgrp - - (colspec*, spanspec*, capbody) >
<!ATTLIST capgrp
            cols   NUMBER  #REQUIRED
            align (left | right | center) "left"
            toctype (none | redtoc | comdtoc | ambertoc | greentoc | yelowtoc)
             "none"
            %bodyatt;
            colsep NUMBER #IMPLIED
            rowsep NUMBER #IMPLIED >

<!-- changed %INSDEL; to %bodyatt;, added attribute cols, new content model -->



<!--**********************************************************************
    * Define Element CAPBODY (Caption Group Body) containing:-           *
    *   CAPROW   - mandatory  repeatable  contains CAPENTRY.             *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  VALIGN   - DECLARED - "TOP"    - Text vertical positioning within *
    *                      - the entries.                                *
    *           - "TOP"    - Align text vertically to top of entries.    *
    *           - "MIDDLE" - Approximately vertically centered.          *
    *           - "BOTTOM" - Align text vertically to bottom of entries. *
    ********************************************************************** -->

<!ELEMENT capbody - o (caprow+) >
<!ATTLIST capbody
              valign       (top | middle | bottom)  "top"  >
<!-- New element -->



<!--**********************************************************************
    * Define Element CAPROW (Row of Captions) containing:-               *
    *   CAPENTRY - mandatory  repeatable  contains APPLIC, CAPTION,      *
    *                                      CAPTEXT.                      *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):                                                      *
    *  ROWSEP   - NUMBER   - IMPLIED  - Internal Row rulings.            *
    *           - "0"      - Do Not display internal row rulings.        *
    *           - "1"      - Display internal row rulings.               *
    * Attribute Definition list stored in entity %bodyatt;               *
    ********************************************************************** -->

<!ELEMENT caprow       - o       (capentry)+ >
<!ATTLIST caprow
              rowsep       %yesorno;      #IMPLIED
              %bodyatt; >
<!-- Change %INSDEL; to %bodyatt;, New content model -->



<!--**********************************************************************
    * Define Element CAPENTRY (Caption Group Entry) containing:-         *
    *  APPLIC   - optional  single     contains TYPE, MODEL.             *
    *--------------------------------------------------------------------*
    * Optional Repeatable Group                                          *
    *--------------------------------------------------------------------*
    *  CAPTION  - mandatory single     contains Parsed Character Data.   *
    * or                                                                 *
    *  CAPTEXT  - mandatory single     contains Parsed Character Data,   *
    *                                   XREF, INDXFLAG, CHANGE, EMPHASIS,*
    *                                   SUBSCRPT, SUPSCRPT, REFDM, REFTP.*
    *--------------------------------------------------------------------*
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  COLNAME  - NMTOKEN  - IMPLIED  - Column name of entry.            *
    *  NAMEST   - NMTOKEN  - IMPLIED  - Name of the left most column of  *
    *                      - the span.                                   *
    *  NAMEEND  - NMTOKEN  - IMPLIED  - Name of the right most column of *
    *                      - the span.                                   *
    *  SPANNAME - NMTOKEN  - IMPLIED  - Name of horizontal span.         *
    *  MOREROWS - NUMBER   - "0"      - Number of additional rows in a   *
    *                      - vertical straddle.                          *
    *  COLSEP   - NUMBER   - IMPLIED  - Internal Column rulings.         *
    *           - "0"      - Do Not display internal column rulings.     *
    *           - "1"      - Display internal column rulings.            *
    *  ROWSEP   - NUMBER   - IMPLIED  - Internal Row rulings.            *
    *           - "0"      - Do Not display internal row rulings.        *
    *           - "1"      - Display internal row rulings.               *
    *  ROTATE   - NUMBER   - "0"      - Rotation of entry content.       *
    *           - "0"      - Content is in the orientation of the table. *
    *           - "1"      - Content is 90 degrees counterclockwise to   *
    *                      - table orientation.                          *
    *  VALIGN   - DECLARED - "TOP"    - Text vertical positioning within *
    *                      - the entries.                                *
    *           - "TOP"    - Align text vertically to top of entries.    *
    *           - "MIDDLE" - Approximately vertically centered.          *
    *           - "BOTTOM" - Align text vertically to bottom of entries. *
    *  ALIGN    - DECLARED - IMPLIED  - Text horizontal position within  *
    *                      - the column.                                 *
    *           - "LEFT"   - Quad (flush) left.                          *
    *           - "CENTER" - Centered.                                   *
    *           - "RIGHT"  - Quad (flush) right.                         *
    *           - "JUSTIFY"- Both quad left and quad right.              *
    ********************************************************************** -->

<!ELEMENT capentry - o (applic?, (caption | captext)?) >
<!ATTLIST capentry
              colname      NMTOKEN        #IMPLIED
              namest       NMTOKEN        #IMPLIED
              nameend      NMTOKEN        #IMPLIED
              spanname     NMTOKEN        #IMPLIED
              morerows     NUMBER         "0"
              colsep       %yesorno;      #IMPLIED
              rowsep       %yesorno;      #IMPLIED
              valign       (top | bottom | middle)  "top"
              align        (left | right | center | justify)
                                          #IMPLIED >
<!-- New element -->



<!--**********************************************************************
    * Define Element CAPTION (Caption) containing:-                      *
    *  Parsed Character Data.                                            *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):                                                      *
    *  COLOUR   - Declared - "CLEAR"  - Colour of Caption.               *
    *           - "RED"    - Red Caption                                 *
    *           - "YELLOW" - Yellow Caption.                             *
    *           - "AMBER"  - Amber Caption                               *
    *           - "GREEN"  - Green Caption.                              *
    *           - "CLEAR"  - Clear Caption.                              *
    *           - "WHITE"  - White Caption.                              *
    *           - "GREY"   - Grey Caption.                               *
    *  WIDTH    - CDATA    - IMPLIED - Width of caption box              *
    *  HEIGHT   - CDATA    - IMPLIED - Height of caption box             *
    *  SYSID    - CDATA    - IMPLIED - External flight systems identifier*
    *                                  for caption                       *
    *  ALIGN    - DECLARED - "CENTER" - Alignment of text within Caption *
    *                                    box.                            *
    *           - "LEFT"   - Quad (flush) left.                          *
    *           - "CENTER" - Centered.                                   *
    *           - "RIGHT"  - Quad (flush) right.                         *
    *           - "JUSTIFY"- Both quad left and quad right.              *
    *  TOCTYPE  - Declared - "NONE"   - Identifies the appropriate Table *
    *                                   of Contents                      *
    *  TYPE     - DECLARED - "PRIMARY" - Type of caption                 *
    *           - "PRIMARY"   - Primary level caption                    *
    *           - "SECONDARY" - Secondary level caption                  *
    * Attribute Definition list stored in entity %bodyatt;               *
    ********************************************************************** -->

<!ELEMENT caption - o (capline+) >
<!ATTLIST caption
            colour (red | yellow | amber | green | clear | white | grey)
             "clear"
            width  CDATA #IMPLIED
            height CDATA #IMPLIED
            sysid  CDATA #IMPLIED
            align (left | right | justify | center) "center"
            toctype (none | redtoc | combtoc | ambertoc | greentoc | yelowtoc)
             "none"
            type (primary | secondary) "primary"
            %bodyatt; >
<!-- Content model & attribute list changed -->


<!--**********************************************************************
    * Define Element CAPLINE (Caption line of text) containing :-        *
    *  Parsed character data                                             *
    ********************************************************************** -->

<!ELEMENT capline o o (#PCDATA) >



<!--**********************************************************************
    * Define Element CAPTEXT (Caption Text [not within a caption box])   *
    *  containing :-                                                     *
    *--------------------------------------------------------------------*
    *  Mandatory Repeatable Group.                                       *
    *--------------------------------------------------------------------*
    *   Parsed Character Data.                                           *
    *  or                                                                *
    *   XREF     - mandatory single     contains No Other Tags.          *
    *  or                                                                *
    *   INDXFLAG - mandatory single     contains No Other Tags.          *
    *  or                                                                *
    *   CHANGE   - mandatory single     contains definition stored in    *
    *                                   entity %text;                    *
    *  or                                                                *
    *   EMPHASIS - mandatory single     contains definition stored in    *
    *                                   entity %text;                    *
    *  or                                                                *
    *   SUBSCRPT - mandatory single     contains Replaceable Character   *
    *                                   Data.                            *
    *  or                                                                *
    *   SUPSCRPT - mandatory single     contains Replaceable Character   *
    *                                   Data.                            *
    *  or                                                                *
    *   REFDM    - mandatory single     contains definition stored in    *
    *                                   entity %ALLDMC;                  *
    *  or                                                                *
    *   REFTP    - mandatory single     contains TECHPUB.                *
    *--------------------------------------------------------------------*
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):                                                      *
    * Attribute Definition list stored in entity %INSDEL;                *
    ********************************************************************** -->

<!ELEMENT captext - o (#PCDATA | xref | indxflag | change | emphasis |
                       subscrpt | supscrpt | refdm | reftp)+ >
<!ATTLIST captext
            %INSDEL; >

<!-- New element -->

