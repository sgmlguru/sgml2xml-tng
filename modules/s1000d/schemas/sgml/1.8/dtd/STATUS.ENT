<!--**********************************************************************
    *                                                                    *
    *                     AECMA 1000D Change 8                           *
    *                   Document Type Definition                         *
    *                                                                    *
    *                     Release Version 1.8                            *
    *                   Dated 31st January 1999                          *
    *                                                                    *
    * Amendment :-                                                       *
    * 1. Update Public Identifier.                                       *
    * 2. CPF 98-33F Move Product Management Data from Status to          *
    *     Preliminary Requirements                                       *
    *  a. Remove PMDATA from entity declaration %STATUS;                 *
    *  b. Remove Product Management Data elements from the status entity.*
    * 3. CPF 98-30D Add ID attributes to required elements               *
    *  a. Change attribute entity %INSDEL; to %bodyatt; for elements :-  *
    *      CHANGE                                                        *
    *  b. Added ID attribute to elements :-                              *
    *      ORIG, RPC, STATUS                                             *
    * 4. CPF 98-59 Change SKILL element to EMPTY, and add the attribute  *
    *     SKILL from the PERSKILL element.                               *
    *                                                                    *
    *   Typical invocation :                                             *
    * <!ENTITY % EXTSTAT                                                 *
    *   PUBLIC "-//AECMA//ELEMENTS Status Breakdown 19990131//EN" >      *
    * %EXTSTAT;                                                          *
    ********************************************************************** -->



<!--**********************************************************************
    * Define Entity %STATUS (Status) containing:-                        *
    *  SECURITY - mandatory single     contains No Other Tags.           *
    *  DMSIZE   - optional  single     contains Parsed Character Data.   *
    *  RPC      - mandatory single     contains Parsed Character Data.   *
    *  ORIG     - mandatory single     contains Parsed Character Data.   *
    *  APPLIC   - mandatory single     contains TYPE, MODEL.             *
    *  TECHSTD  - optional  single     contains AUTANDTP, AUTHBLK, TPBASE*
    *                                  AUTHEX, NOTES.                    *
    *  QA       - mandatory single     contains UNVERIF, FIRSTVER, SECVER*
    *--------------------------------------------------------------------*
    * Optional Single Group                                              *
    *--------------------------------------------------------------------*
    *  SBC      - mandatory single     contains definition stored in     *
    *                                   entity %SBC;                     *
    * or                                                                 *
    *  FIC      - optional  repeatable contains definition stored in     *
    *                                   entity %FIC;                     *
    *--------------------------------------------------------------------*
    *  SKILL    - optional  single     contains Parsed Character Data.   *
    *  RFU      - optional  single     contains Parsed Character Data.   *
    *  REMARKS  - optional  single     contains Parsed Character Data.   *
    ********************************************************************** -->

<!ENTITY % STATUS
  "security,dmsize?,rpc,orig,applic,techstd?,qa,(sbc|fic)?,skill?,
   rfu?,remarks?" >
<!-- Remove reference to pmdata element -->



<!--**********************************************************************
    * Define Element STATUS (Status) containing:-                        *
    *  Definition stored in entity %STATUS.                              *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  ID       - ID       - IMPLIED  - Unique identifier of status      *
    ********************************************************************** -->

<!ELEMENT status - o (%STATUS;) >
<!ATTLIST status
            id   ID  #IMPLIED >
<!-- Added attribute list to status element -->



<!--**********************************************************************
    * Define Element DMSIZE (Data Module Size) containing:-              *
    *  Parsed Character Data.                                            *
    ********************************************************************** -->

<!ELEMENT dmsize   - o (#PCDATA) >



<!--**********************************************************************
    * Define Element SECURITY (Security Marking) containing:-            *
    *  No Other Tags.                                                    *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    * Attribute Definition List stored in Entity %SECURIT;               *
    ********************************************************************** -->

<!ELEMENT security  - o EMPTY >
<!ATTLIST security %SECURIT; >



<!--**********************************************************************
    * Define Element RPC (Responsible Partner Company) containing:-      *
    *  Parsed Character Data.                                            *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  RPCNAME  - %RPCNAME - The name or NCAGE code of the responsible   *
    *                        partner company.                            *
    *  ID       - ID       - IMPLIED - Unique identifier of Responsible  *
    *                        partner company                             *
    ********************************************************************** -->

<!ELEMENT rpc      - o (#PCDATA) >
<!ATTLIST rpc
            rpcname  %RPCNAME;  #IMPLIED
            id       ID         #IMPLIED >
<!-- Added id attribute to attribute definition list -->



<!--**********************************************************************
    * Define Element ORIG (Originator) containing:-                      *
    *  Parsed Character Data.                                            *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  ORIGNAME - %ORGNAME - The name or NCAGE code of the originator.   *
    *  ID       - ID       - IMPLIED - Unique identifier of Originator   *
    ********************************************************************** -->

<!ELEMENT orig     - o (#PCDATA) >
<!ATTLIST orig
            origname  %ORGNAME;  #IMPLIED
            id        ID         #IMPLIED >
<!-- Added id attribute to attribute definition list -->



<!--**********************************************************************
    * Call the Applicability Breakdown public text. The formal public    *
    * identifier is stored in entity %EXTAPPL;                           *
    ********************************************************************** -->

%EXTAPPL;



<!--**********************************************************************
    * Define Element TECHSTD (Technical Standard) containing:-           *
    *--------------------------------------------------------------------*
    *   AUTANDTP - mandatory single     contains AUTHBLK, TPBASE         *
    *  or                                                                *
    *   AUTHBLK  - mandatory single     contains Parsed Character Data.  *
    *  or                                                                *
    *   TPBASE   - mandatory single     contains Parsed Character Data.  *
    *--------------------------------------------------------------------*
    *   AUTHEX   - mandatory single     contains INLINE, RETROFIT.       *
    *   NOTES    - mandatory single     contains Parsed Character Data.  *
    ********************************************************************** -->

<!ELEMENT techstd - o ((autandtp|authblk|tpbase),authex,notes) >



<!--**********************************************************************
    * Define Element AUTANDTP (Authority Block & Technical Publication   *
    * Baseline) containing:-                                             *
    *   AUTHBLK  - mandatory single     contains Parsed Character Data.  *
    *   TPBASE   - mandatory single     contains Parsed Character Data.  *
    ********************************************************************** -->

<!ELEMENT autandtp - o (authblk,tpbase) >



<!--**********************************************************************
    * Define the following elements:-                                    *
    *   AUTHBLK  - Authority Block.                                      *
    *   TPBASE   - Technical Publication Base Line.                      *
    *  Containing:- Parsed Character Data.                               *
    ********************************************************************** -->

<!ELEMENT (authblk|tpbase) - o (#PCDATA) >



<!--**********************************************************************
    * Define Element AUTHEX (Authority Exceptions) containing:-          *
    *   INLINE   - optional  single     contains EXMOD, ADDMOD.          *
    *   RETROFIT - optional  single     contains no other tags.          *
    ********************************************************************** -->

<!ELEMENT authex - o (inline?,retrofit?) >



<!--**********************************************************************
    * Define Element INLINE (Inline Information) containing:-            *
    *   EXMOD    - optional  repeatable contains Parsed Character Data.  *
    *   ADDMOD   - optional  repeatable contains Parsed Character Data.  *
    ********************************************************************** -->

<!ELEMENT inline - o (exmod*,addmod*) >



<!--**********************************************************************
    * Define Element EXMOD (Excluded Modifications) containing:-         *
    *   Parsed Character Data.                                           *
    ********************************************************************** -->

<!ELEMENT exmod - o (#PCDATA) >



<!--**********************************************************************
    * Define Element ADDMOD (Additional Modifications) containing:-      *
    *   Parsed Character Data.                                           *
    ********************************************************************** -->

<!ELEMENT addmod - o (#PCDATA) >



<!--**********************************************************************
    * Define Element RETROFIT (Retrofit Information) containing :-       *
    *   MOD      - mandatory repeatable contains No Other Tags.          *
    ********************************************************************** -->

<!ELEMENT retrofit - o  (mod+) >



<!--**********************************************************************
    * Define Element MOD (Modification Order) containing:-               *
    *  No Other Tags.                                                    *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  AUTHNO   - NMTOKEN  - REQUIRED - Retrofit order number.           *
    *  MODTYPE  - DECLARED - REQUIRED - Standard for this modification.  *
    *           - "PRE"     - Pre-modification.                          *
    *           - "POST"    - Post modification.                         *
    *           - "PRANDPO" - Both Pre & Post modifications.             *
    ********************************************************************** -->

<!ELEMENT mod - o EMPTY >
<!ATTLIST mod
            authno NMTOKEN #REQUIRED
            modtype (PRE | POST | PRANDPO) #REQUIRED >



<!--**********************************************************************
    * Define Element NOTES (Notes) containing:-                          *
    *  Parsed Character Data.                                            *
    ********************************************************************** -->

<!ELEMENT notes - o (#PCDATA) >



<!--**********************************************************************
    * Define Element QA (Quality Assurance Status) containing:-          *
    *   UNVERIF  - mandatory single     contains no other tags.          *
    *  or                                                                *
    *   FIRSTVER - mandatory single     contains no other tags.          *
    *   SECVER   - optional  single     contains no other tags.          *
    ********************************************************************** -->

<!ELEMENT qa - o (unverif|(firstver,secver?)) >



<!--**********************************************************************
    * Define Element UNVERIF (Unverified) containing:-                   *
    *   No other tags.                                                   *
    ********************************************************************** -->

<!ELEMENT unverif - o EMPTY >



<!--**********************************************************************
    * Define the following elements:-                                    *
    *   FIRSTVER - First Level Verification (By SDR Contractor).         *
    *   SECVER   - Second Level Verification (By Customer).              *
    *  Containing :- No other tags.                                      *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  TYPE     - DECLARED - Type of verification performed.             *
    *           - "TABTOP"   - Performed with only designs and drawings. *
    *           - "ONOBJECT" - Performed with actual piece of equipment. *
    *           - "TTANDOO"  - Performed by both the above ways.         *
    ********************************************************************** -->

<!ELEMENT (firstver|secver) - o EMPTY >
<!ATTLIST (firstver|secver)
            type (tabtop|onobject|ttandoo) #REQUIRED >



<!--**********************************************************************
    * Define Element SBC (System Breakdown Code) containing:-            *
    *  Definition stored in entity %SBC;                                 *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  ID       - ID       - IMPLIED - Unique identifier of system       *
    *                                   breakdown code                   *
    ********************************************************************** -->

<!ELEMENT sbc - o (%SBC;) >
<!ATTLIST sbc
            id   ID  #IMPLIED >
<!-- Added attribute list to sbc element -->



<!--**********************************************************************
    * Define Element FIC (Functional Item Code) containing:-             *
    *  Definition stored in entity %FIC;                                 *
    **********************************************************************-->

<!ELEMENT fic - o (%FIC;) >



<!--**********************************************************************
    * Define the following elements:-                                    *
    *   RFU      - Reason For Update.                                    *
    *   REMARKS  - Remarks.                                              *
    * containing Parsed Character Data.                                  *
    ********************************************************************** -->

<!ELEMENT (rfu | remarks) - o (#PCDATA) >



<!--**********************************************************************
    * Define Element SKILL  (Skill Level) containing:-                   *
    *  No Other Tags.                                                    *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  SKILL    - DECLARED - REQUIRED - Personnel skill level            *
    *             Definition stored in entity %SKILL;                    *
    ********************************************************************** -->

<!ELEMENT skill - o EMPTY>
<!ATTLIST skill
             skill %SKILL; #REQUIRED>
<!-- Changed SKILL element to EMPTY and added new attribute SKILL -->



<!-- Removed Product Management Data elements into separate entity -->