<!--**********************************************************************
    *                                                                    *
    *                     AECMA 1000D Change 8                           *
    *                   Document Type Definition                         *
    *                                                                    *
    *                     Release Version 1.8                            *
    *                   Dated 31st January 1999                          *
    *                                                                    *
    * Amendment :-                                                       *
    * 1. CPF 99-67UK Harmonize AGE & AVEE variants of the DTD.           *
    *  a. New formal public identifier                                   *
    *  b. Removal of entities %AGEDMC; %AVEEDMC;                         *
    * 2. Reference new component definition public identifier.           *
    * 3. CPF 98-54UK Restructure to single applicability for both AVEE   *
    *     & AGE                                                          *
    *  a. Removal of entities %AGEAPP; , %AVEEAPP;, %NSN;, & %MANUFCT;   *
    *      due to common applicability                                   *
    * 4. CPF 98-??? Harmonize Caption handling, Also allow captions in   *
    *     AVEE Descriptive & Procedural.                                 *
    *  a. Added entity declaration %CAPPCON;                             *
    *                                                                    *
    * The following DOCTYPE statement may be used to call this set of    *
    * declarations:-                                                     *
    *                                                                    *
    * <!DOCTYPE dmodule PUBLIC                                           *
    *  "-//AECMA//DTD AECMA 1000D Description 19990131//EN" [            *
    *  ]>                                                                *
    ********************************************************************** -->



<!--**********************************************************************
    * Define Entity %COMPS; (Components) containing:- the formal public  *
    * identifier for the component definitions.                          *
    ********************************************************************** -->

<!ENTITY % COMPS
 PUBLIC "-//AECMA//ENTITIES Component Definitions 19990131//EN" >



<!--**********************************************************************
    * Call the Components Definition Public Text. The formal public      *
    * identifier is stored in the entity %COMPS;                         *
    ********************************************************************** -->

%COMPS;



<!-- Removal of entities %AGEDMC;, %AVEEDMC;, %AGEAPP;, %AVEEAPP; -->



<!--**********************************************************************
    * Define Entity %CAPPCON; (Caption Paragraphc Continuation)          *
    * containing:                                                        *
    * or                                                                 *
    *  CAPGRP   - mandatory single     contains COLSPEC, SPANSPEC,       *
    *                                   CAPBODY.                         *
    ********************************************************************** -->

<!ENTITY % CAPPCON "| capgrp" >
<!-- Added entity declaration for %CAPPCON; -->



<!--**********************************************************************
    * Call the AECMA Configuration Public Text.                          *
    * The formal public identifier is stored in the entity %AECMA;       *
    ********************************************************************** -->

%AECMA;



<!--**********************************************************************
    * Call the AECMA Base DTD Public Text. The formal public identifier  *
    * is stored in the entity %BASE;                                     *
    ********************************************************************** -->

%BASE;



<!-- Removal of entities %NSN; & %MANUFCT; -->



<!--**********************************************************************
    * Call the Desription Content Public Text.                           *
    * The formal public identifier is stored in the entity %DESCRPT;     *
    ********************************************************************** -->

%DESCRPT;



<!--**********************************************************************
    * Call the Content Breakdown Public Text. The formal public          *
    * identifier is stored in the entity %EXTCONT;                       *
    ********************************************************************** -->

%EXTCONT;
