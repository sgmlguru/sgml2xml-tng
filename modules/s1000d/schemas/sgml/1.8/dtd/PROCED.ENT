<!--**********************************************************************
    *                                                                    *
    *                     AECMA 1000D Change 8                           *
    *                   Document Type Definition                         *
    *                                                                    *
    *                     Release Version 1.8                            *
    *                   Dated 31st January 1999                          *
    *                                                                    *
    * Amendment :-                                                       *
    * 1. Update Public Identifier                                        *
    * 2. CPF 98-30D Add ID attributes to required elements               *
    *  a. Added attribute definition list with %bodyatt; value to        *
    *     elements :-                                                    *
    *      CLOSEUP, MAINFUNC                                             *
    * 3. CPF 98-??? Harmonize Caption handling, Also allow captions in   *
    *     AVEE Descriptive & Procedural.                                 *
    *  a. Added entity declaration %CAPPCON;                             *
    *                                                                    *
    * Typical invocation :                                               *
    * <!ENTITY % PROCED                                                  *
    *   PUBLIC "-//AECMA//ELEMENTS Procedural Breakdown 19990131//EN" >  *
    * %PROCED;                                                           *
    ********************************************************************** -->



<!--**********************************************************************
    * Define Entity %CONTENT (Content Breakdown) containing :- PROCED    *
    ********************************************************************** -->

<!ENTITY % CONTENT "proced" >



<!--**********************************************************************
    * Define Element PROCED (Procedural Information) containing:-        *
    *   PRELREQS - mandatory  single     contains PMD, REQCOND, REQPERS, *
    *                                    SUPEQUIP, SUPPLIES, SPARES,     *
    *                                     SAFETY.                        *
    *   MAINFUNC - mandatory  single     contains STEP1.                 *
    *   CLOSEUP  - mandatory  single     contains NOCLOSE, STEP1, REFS.  *
    ********************************************************************** -->

<!ELEMENT proced - o (prelreqs,mainfunc,closeup) >



<!--**********************************************************************
    * Call the Preliminary Requirements Public Text.                     *
    * The formal public identifier is stored in the entity %PRELREQ;     *
    ********************************************************************** -->

%PRELREQ;



<!--**********************************************************************
    * Define Element MAINFUNC (Maintenance Function) containing:-        *
    *   STEP1    - mandatory repeatable contains definition stored in    *
    *                                   entity %stepcon; STEP2.          *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  Attribute Definition list stored in entity %bodyatt;              *
    **********************************************************************
    * INCLUSION :- FIGURE, FOLDOUT, TABLE.                               *
    ********************************************************************** -->

<!ELEMENT mainfunc - o (step1+)   +(figure | foldout | table) >
<!ATTLIST mainfunc
            %bodyatt; >
<!-- Added attribute list to mainfunc element -->



<!--**********************************************************************
    *  Define Element CLOSEUP (Close up procedures) containing :-        *
    *   NOCLOSE - mandatory  single    contains No Other Tags.           *
    * or                                                                 *
    *--------------------------------------------------------------------*
    * Mandatory Repeatable Group                                         *
    *--------------------------------------------------------------------*
    *   STEP1   - mandatory single     contains definition stored in     *
    *                                   entity %stepcon; STEP2.          *
    * or                                                                 *
    *   REFS    - mandatory single     contains NOREFS, RDANDRT, REFDMS, *
    *                                   REFTP.                           *
    *--------------------------------------------------------------------*
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  Attribute Definition list stored in entity %bodyatt;              *
    **********************************************************************
    * INCLUSION :- FIGURE, FOLDOUT, TABLE.                               *
    ********************************************************************** -->

<!ELEMENT closeup - o (noclose | (step1 | refs)+)
           +(figure | foldout | table) >
<!ATTLIST closeup
            %bodyatt; >
<!-- Added attribute list to closeup element -->



<!--**********************************************************************
    *  Define Element NOCLOSE (No Close Up procedures) containing:-      *
    *  No Other Tags.                                                    *
    ********************************************************************** -->

<!ELEMENT noclose - o EMPTY >



<!--**********************************************************************
    * Call the Steps Public Text.                                        *
    * The formal public identifier is stored in the entity %EXTSTEP;     *
    ********************************************************************** -->

%EXTSTEP;



<!--**********************************************************************
    * Call the Lists Public Text.                                        *
    * The formal public identifier is stored in the entity %EXTLIST;     *
    ********************************************************************** -->

%EXTLIST;



<!--**********************************************************************
    * Call the Figure And Table Public Text.                             *
    * The formal public identifier is stored in the entity %EXTFTAB;     *
    ********************************************************************** -->

%EXTFTAB;



<!--**********************************************************************
    * Call the Special Paragraphs Public Text.                           *
    * The formal public identifier is stored in the entity %EXTSPEC;     *
    ********************************************************************** -->

%EXTSPEC;



<!--**********************************************************************
    * Call the Caption Group Public Text.                                *
    * The formal public identifier is stored in the entity %CAPGRP;      *
    ********************************************************************** -->

%CAPGRP;
<!-- Added entity reference -->
