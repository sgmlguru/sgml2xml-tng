<!--**********************************************************************
    *                                                                    *
    *                     AECMA 1000D Change 8                           *
    *                   Document Type Definition                         *
    *                                                                    *
    *                     Release Version 1.8                            *
    *                   Dated 31st January 1999                          *
    *                                                                    *
    * Amendment :-                                                       *
    * CPF 98-33F Move Product Management Data from status                *
    * 1. New Public Identifier for Product Management Data.              *
    * 2. CPF 98-34F. Change Zone from optional to mandatory              *
    * 3. CPF 98-35F. Redefine status and power source as direct          *
    *     attributes of air vehicle config elements,                     *
    *     delete elements AIRVSTAT, POWER                                *
    * 2. CPF 98-30D Add ID attributes to required elements               *
    *  a. Added ID attribute to elements :-                              *
    *      OPNDURN, ZONE                                                 *
    *                                                                    *
    *   Typical invocation :                                             *
    * <!ENTITY % PMDATA                                                  *
    *  PUBLIC "-//AECMA//ELEMENTS Product Management Data 19990131//EN" >*
    * %PMDATA;                                                           *
    ********************************************************************** -->



<!--**********************************************************************
    * Define the element PMD (Production Management Data) containing :-  *
    *  THI      - optional  repeatable contains Parsed Character Data.   *
    *  ZONE     - optional  repeatable contains Parsed Character Data.   *
    *  ACCPNL   - optional  repeatable contains Parsed Character Data.   *
    *  AVEHCFG  - mandatory single     contains jacked, safedev, elecpwr,*
    *                                   hydpwr, airpwr, fuel, water,     *
    *                                   fcposn.                          *
    *  OPNDURN  - mandatory single     contains no other tags.           *
    ********************************************************************** -->

<!ELEMENT pmd - o (thi*, zone*, accpnl*, avehcfg, opndurn) >



<!--**********************************************************************
    * Define element THI (Threshold Interval) containing:-               *
    *  Parsed Character Data                                             *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    * UOM       - DECLARED   - REQUIRED - Unit of Measurement            *
    *           - "FLTHRS"   - Flight Hours                              *
    *           - "FLTCYC"   - Flight Cycles                             *
    *           - "MONTHS"   - Months                                    *
    *           - "WEEKS"    - Weeks                                     *
    *           - "YEARS"    - Years                                     *
    *           - "DAYS"     - Days                                      *
    *           - "SUPERCYC" - Supersonic cycles                         *
    *           - "PRESSCYC" - Pressure cycles                           *
    *           - "ENGCYC"   - Engine cycles                             *
    *           - "ENGCHG"   - Engine change                             *
    *           - "SHOPVIST" - Shop Visit                                *
    *           - "APUCHG"   - Auxiliary power unit change               *
    *           - "LANDGCHG" - Landing gear change                       *
    *           - "WHEELCHG" - Wheel change                              *
    ********************************************************************** -->

<!ELEMENT thi - o (#PCDATA) >
<!ATTLIST thi
          uom (FLTHRS | FLTCYC | MONTHS | WEEKS | YEARS | DAYS | SUPERCYC |
               PRESSCYC | ENGCYC | ENGCHG | SHOPVIST | APUCHG | LANDGCHG |
               WHEELCHG) #REQUIRED >



<!--**********************************************************************
    * Define element ZONE (Zone) containing:-                            *
    *  Parsed Character Data                                             *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    * ID       - ID     - IMPLIED - Unique identifier of zone            *
    ********************************************************************** -->

<!ELEMENT zone - o (#PCDATA) >
<!ATTLIST zone
            id  ID  #IMPLIED >
<!-- Added attribute list to zone element -->



<!--**********************************************************************
    * Define element ACCPNL (Access Panel) containing :-                 *
    *  Parsed Character Data                                             *
    ********************************************************************** -->

<!ELEMENT accpnl - o (#PCDATA) >



<!--**********************************************************************
    * Define element AVEHCFG (Air Vehicle Required Conditions) containing*
    *  JACKED   - mandatory single  contains no other tags.              *
    *  SAFEDEV  - mandatory single  contains no other tags.              *
    *  ELECPWR  - mandatory single  contains no other tags.              *
    *  HYDPWR   - mandatory single  contains no other tags.              *
    *  AIRPWR   - mandatory single  contains no other tags.              *
    *  FUEL     - mandatory single  contains no other tags.              *
    *  WATER    - mandatory single  contains no other tags.              *
    *  FCPOSN   - mandatory single  contains no other tags.              *
    ********************************************************************** -->

<!ELEMENT avehcfg - o
           (jacked, safedev, elecpwr, hydpwr, airpwr, fuel, water, fcposn) >



<!--**********************************************************************
    * Define elements                                                    *
    * JACKED   - Jacked                                                  *
    * SAFEDEV  - Safety devices                                          *
    * ELECPWR  - Electrical power                                        *
    * HYDPWR   - Hydraulic power                                         *
    * AIRPWR   - Air power                                               *
    * FUEL     - Fuel                                                    *
    * WATER    - Water                                                   *
    * FCPOSN   - Flight control position                                 *
    *  Containing no other tags                                          *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):                                                      *
    * STATUS    - DECLARED - REQUIRED - Status of air vehicle            *
    *                                    configuration criteria          *
    *           - "YES"      - Obligation                                *
    *           - "NO"       - Prohibited                                *
    *           - "INDIFFER" - Indifferent                               *
    *           - "NA"       - Not Applicable                            *
    * POWER     - DECLARED - REQUIRED - Power source                     *
    *           - "ENGINE"      - Engine                                 *
    *           - "APU"         - APU                                    *
    *           - "EXTERNAL"    - External                               *
    *           - "INTERNAL"    - Internal                               *
    *           - "INDIFFERENT" - Indifferent                            *
    *           - "NOTAPPLIC"   - Not Applicable                         *
    ********************************************************************** -->

<!ELEMENT (jacked | safedev | elecpwr | hydpwr | airpwr | fuel | water |
           fcposn) - o EMPTY >
<!ATTLIST (jacked | safedev | elecpwr | hydpwr | airpwr | fuel | water |
           fcposn)
            status (YES | NO | INDIFFER | NA) #REQUIRED
            power  (ENGINE | APU | EXTERNAL | INTERNAL | INDIFFERENT | NOTAPPLIC)
             #REQUIRED >

<!-- Deleted elements AIRVSTAT, POWER, Move attributes to configuration elements 
     and changed content of configuration elements to empty, changed power
     attribute values from NA to NOTAPPLIC & INDIFFER to INDIFFERENT -->



<!--**********************************************************************
    * Define Element OPNDURN (Operation Duration) containing:-           *
    *  No Other Tags                                                     *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):                                                      *
    * PRELREQS - number - Duration of preliminary requirements (manhours)*
    * PROCED   - number - Duration of procedure (manhours)               *
    * CLOSEUP  - number - Duration of close-up requirements (manhours)   *
    * ID       - ID     - IMPLIED - Unique identifier of Operation       *
    *                                Duration                            *
    ********************************************************************** -->

<!ELEMENT opndurn - o EMPTY >
<!ATTLIST opndurn
          prelreqs NUMBER #REQUIRED
          proced   NUMBER #REQUIRED
          closeup  NUMBER #REQUIRED
          id       ID     #IMPLIED >
<!-- Added id attribute to attribute definition list -->

