<!--**********************************************************************
    *                                                                    *
    *                     AECMA 1000D Change 8                           *
    *                   Document Type Definition                         *
    *                                                                    *
    *                     Release Version 1.8                            *
    *                   Dated 31st January 1999                          *
    *                                                                    *
    * Amendment :-                                                       *
    * 1. Update Public Identifier                                        *
    * 2. CPF 98-30D Add ID attributes to required elements               *
    *  a. Change attribute entity %INSDEL; to %bodyatt; for elements :-  *
    *      DEFTASK, INSPECTION, LIMIT, LIMITTYPE, REFINSPEC, SUPERVIS    *
    *  b. Added attribute definition list with %bodyatt; value to        *
    *     elements :-                                                    *
    *      EQUIP                                                         *
    *  c. Added ID attribute to elements :-                              *
    *      TASKITEM                                                      *
    * 3. CPF 98-65D Harmonize QUANTITY & QTY to QTY.                     *
    * 4. CPF 99-37D                                                      *
    *  a. Change content model of THRESHOLD, removed element UOM.        *
    *  b. Added attribute UOM to element THRESHOLD.                      *
    * 5. CPF 98-54UK Restructure to single applicability for both AVEE   *
    *     & AGE                                                          *
    *  a. Removal of entity %MANUFCT; due to common applicability        *
    *                                                                    *
    * Typical invocation :                                               *
    * <!ENTITY % SCHEDUL                                                 *
    *   "-//AECMA//ELEMENTS Schedule Breakdown 19990131//EN" >           *
    * %SCHEDUL;                                                          *
    ********************************************************************** -->



<!--**********************************************************************
    * Define Entity %CONTENT (Content Breakdown) containing :- SCHEDULE  *
    ********************************************************************** -->
 
<!ENTITY % CONTENT "schedule" >



<!--**********************************************************************
    * Define Element SCHEDULE (Schedule information) containing:-        *
    *   DEFINSPEC   - mandatory repeatable contains INSPECTION, TASKLIST *
    * or                                                                 *
    *   DEFTASK     - mandatory repeatable contains TASK, PRELREQS, REFS,*
    *                                      EQUIP, SUPERVIS, LIMIT, APPLIC*
    * or                                                                 *
    *   TIMELIM     - mandatory repeatable contains EQUIP, QTY, CAT,     *
    *                                      TIMELIMIT, APPLIC.            *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  TYPE     - CDATA   - Implied - Type of Schedule                   *
    **********************************************************************-->
 
<!ELEMENT schedule - o (definspec+ | deftask+ | timelim+) >
<!ATTLIST schedule
               type  CDATA    #IMPLIED  >

 

<!--**********************************************************************
    * Define Element DEFINSPEC (Inspection definition) containing:-      *
    *   INSPECTION - mandatory single    contains LIMIT, REMARKS         *
    *   TASKLIST   - optional  single    contains TASKITEM               *
    ********************************************************************** -->
 
<!ELEMENT definspec  - O (inspection, tasklist?) >

 

<!--**********************************************************************
    * Define Element THRESHOLD (Threshold inspection) containing:-       *
    *   VALUE     - mandatory single   contains Parsed Character Data.   *
    *   TOLERANCE - optional  single   contains No other tags.           *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  UOM    - CDATA  - REQUIRED - Unit of measure.                     *
    ********************************************************************** -->

<!ELEMENT threshold  - O (value, tolerance?) >
<!ATTLIST threshold
             uom  CDATA  #REQUIRED >
<!-- Added attribute uom, remove element uom from content model -->



<!--**********************************************************************
    * Define Element EQUIP (Equipment) containing:-                      *
    *--------------------------------------------------------------------*
    * Mandatory Repeatable Group                                         *
    *--------------------------------------------------------------------*
    *  NOMEN    - mandatory single       contains Parsed Character Data. *
    *  NSN      - optional  single       contains no other tags.         *
    *====================================================================*
    * Mandatory Repeatable Group                                         *
    *====================================================================*
    *  IDENTNO  - mandatory single       contains PNR, MFC.              *
    * or                                                                 *
    *  CSNREF   - mandatory single       contains no other tags.         *
    *====================================================================*
    *--------------------------------------------------------------------*
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  Attribute Definition list stored in entity %bodyatt;              *
    ********************************************************************** -->

<!ELEMENT equip  - O (nomen , nsn?, (identno | csnref)+)+ >
<!ATTLIST equip
            %bodyatt; >
<!-- Added attribute list to equip element -->



<!--**********************************************************************
    * Define Element VALUE (Value) containing:-                          *
    *   Parsed Character Data.                                           *
    ********************************************************************** -->

<!ELEMENT value  - O (#PCDATA) >



<!-- Delete uom element -->



<!--**********************************************************************
    * Define Element LIMRANGE (Limit range) containing:-                 *
    *   from    - mandatory single   contains THRESHOLD                  * 
    *   to      - optional  single   contains THRESHOLD                  *
    ********************************************************************** -->

<!ELEMENT limrange  - O (from , to?) >     



<!--**********************************************************************
    * Define Element TIMELIMIT (Time Limit) containing:-                 *
    *   limittype  - mandatory repeatable contains THRESHOLD, REMARKS    * 
    *  or                                                                *
    *   remarks    - optional  repeatable contains Parsed Character Data *
    ********************************************************************** -->

<!ELEMENT timelimit  - O (limittype+ | remarks*) >



<!--**********************************************************************
    * Define Element TASKLIST (Task list) containing:-                   *
    *   taskitem  - mandatory  repeatable contains REFS, TASK, APPLIC    * 
    ********************************************************************** -->

<!ELEMENT tasklist  - O (taskitem+) >



<!--**********************************************************************
    * Define Element From (Limrange from) containing:-                   *
    *   THRESHOLD  - mandatory single   contains VALUE, TOLERANCE.       *
    ********************************************************************** -->

<!ELEMENT from  - O (threshold) >



<!--**********************************************************************
    * Define Element To (Limrange to) containing:-                       *
    *   THRESHOLD  - mandatory single   contains VALUE, TOLERANCE.       *
    ********************************************************************** -->

<!ELEMENT to  - O (threshold) >



<!--**********************************************************************
    * Define Element Sampling (sampling) containing:-                    *
    *  Parsed Character Data.                                            *
    ********************************************************************** -->

<!ELEMENT sampling  - O (#PCDATA) >



<!--**********************************************************************
    * Define Element Tolerance (Tolerance value) containing:-            *
    *  No Other Tags.                                                    *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  MINUS  - NUMBER - Implied - Minus tolerance value                 *
    *  PLUS   - NUMBER - Implied - Plus tolerance value                  *
    ********************************************************************** -->

<!ELEMENT tolerance  - O  EMPTY  >
<!ATTLIST tolerance
              minus  NUMBER    #IMPLIED 
              plus   NUMBER    #IMPLIED  >



<!--**********************************************************************
    * Define Element LIMIT (Time Limit) containing:-                     *
    *   SAMPLING    - optional single     contains Parsed Character Data * 
    *   THRESHOLD   - optional repeatable contains VALUE, TOLERANCE.     * 
    *   REFINSPEC   - optional repeatable contains No other tags.        * 
    *   TRIGGER     - optional single     contains REFS, THRESHOLD.      * 
    *   LIMRANGE    - optional single     contains FROM, TO.             * 
    *   REMARKS     - optional repeatable contains Parsed Character Data *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  TYPEX     - DECLARED - IMPLIED - limit type : punctual, periodic  *
    *  CONDITION - CDATA    - IMPLIED - conditions                       *
    *  Attribute Definition list stored in entity %bodyatt;              *
    ********************************************************************** -->

<!ELEMENT limit  - O (sampling?, threshold*, refinspec*, trigger?, 
               limrange?, remarks*) >
<!ATTLIST limit
             typex (PO , EV , PE)  "PE"
             condition  CDATA    #IMPLIED
             %bodyatt; >
<!-- changed %INSDEL; to %bodyatt; -->



<!--**********************************************************************
    * Define Element TRIGGER (Trigger) containing:-                      *
    *   REFS      - mandatory single contains NOREFS, RDANDRT, REFDM,    *
    *                                REFTP                               * 
    *   THRESHOLD - optional single  contains VALUE, TOLERANCE.          * 
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  release   - Declared - IMPLIED - before, with, after              *
    *  Attribute Definition list stored in entity %INSDEL;               *
    ********************************************************************** -->

<!ELEMENT trigger  - O (refs , threshold?) >
<!ATTLIST trigger
             release (before , with , after)   #IMPLIED 
             %INSDEL;  >


<!--**********************************************************************
    * Define Element timelim (timelim) containing:-                      *
    *   EQUIP     - mandatory single     contains NOMEN, NSN, IDENTNO,   *
    *                                    CSNREF                          * 
    *   QTY       - optional  single     contains Parsed Character Data  * 
    *   CAT       - optional  single     contains No other tags          * 
    *   TIMELIMIT - mandatory repeatable contains LIMITTYPE, REMARKS.    * 
    *   APPLIC    - mandatory single     contains TYPE, MODEL            *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  identifier   - CDATA - REQUIRED -                                 *
    *  Attribute Definition list stored in entity %INSDEL;               *
    ********************************************************************** -->

<!ELEMENT timelim  - O (equip, qty?, cat?, timelimit+, applic) >
<!ATTLIST timelim
             identifier  CDATA    #REQUIRED 
             %INSDEL;  >



<!--**********************************************************************
    * Define Element limittype (limittype) containing:-                  *
    *   THRESHOLD  - mandatory repeatable contains VALUE, TOLERANCE.     * 
    *   REMARKS    - optional  repeatable contains Parsed Character Data * 
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  type         - DECLARED - IMPLIED -                               *
    *  Attribute Definition list stored in entity %bodyatt;              *
    ********************************************************************** -->

<!ELEMENT limittype  - O (threshold+, remarks*) >
<!ATTLIST limittype
             type (tbo , ht , slm , otl , oc , cm , fc)   #IMPLIED 
             %bodyatt; >
<!-- changed %INSDEL; to %bodyatt; -->


<!--**********************************************************************
    * Define Element supervis (Supervisor) containing:-                  *
    *   No other tags                                                    * 
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  sup.Lev    - VALUES - IMPLIED - Supervisor level                  *
    *  Attribute Definition list stored in entity %bodyatt;              *
    ********************************************************************** -->

<!ELEMENT supervis  - O  EMPTY  >
<!ATTLIST supervis
             sup.Lev (1 , 2 , 3 , 4)   #IMPLIED
             %bodyatt; >
<!-- changed %INSDEL; to %bodyatt; -->



<!-- Moved Qty element declaration into Prelreqs.ent -->



<!--**********************************************************************
    * Define Element deftask (task definition) containing:-              *
    *   TASK     - mandatory single     contains Parsed Character Data   *
    *   PRELREQS - optional single      contains PMD, REQCONDS, REQPERS, *
    *                                    SUPEQUIP, SUPPLIES, SPARES,     *
    *                                    SAFETY                          *
    *   REFS     - optional single      contains NOREFS, RDANDRT, REFDMS,*
    *                                   REFTP                            *
    *   EQUIP    - optional  single     contains NOMEN, NSN, IDENTNO,    *
    *                                   CSNREF                           *
    *   SUPERVIS - optional  single     contains No other tags           * 
    *   LIMIT    - optional  repeatable contains SAMPLING, THRESHOLD,    *
    *                                   REFINSPEC, TRIGGER, LIMRANGE,    *
    *                                   REMARKS                          *
    *   APPLIC    - optional single     contains TYPE, MODEL             *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  taskid       - CDATA    - Required - Task identifier              *
    *  airworthlim  - Declared - Implied  - Air worthness limit          *
    *  reducem      - CDATA    - Implied  - Reduce maintenance           *
    *  Attribute Definition list stored in entity %bodyatt;              *
    ********************************************************************** -->

<!ELEMENT deftask  - O (task, prelreqs?, refs?, equip?, supervis?,
                        limit*, applic?) >
<!ATTLIST deftask
             taskid  CDATA    #REQUIRED  
             airworthlim (Recommended , Mandatory , none)   #IMPLIED 
             reducem  CDATA    #IMPLIED 
             %bodyatt; >
<!-- changed %INSDEL; to %bodyatt; -->



<!--**********************************************************************
    * Define Element inspection (inspection) containing:-                *
    *   limit    - optional repeatable contains SAMPLING, THRESHOLD,     *
    *                                  REFINSPEC, TRIGGER, LIMRANGE,     *
    *                                  REMARKS                           * 
    *   remarks  - optional repeatable contains Parsed Character Data.   *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  Attribute Definition list stored in entity %bodyatt;              *
    ********************************************************************** -->

<!ELEMENT inspection  - O (limit* , remarks*) >
<!ATTLIST inspection
             %bodyatt; >
<!-- removed type attribute, changed %INSDEL; to %bodyatt; -->


<!--**********************************************************************
    * Define Element taskitem (taskitem) containing:-                    *
    *   REFS      - optional single     contains NOREFS, RDANDRT, REFDMS,*
    *                                   REFTP                            *
    *   TASK      - optional single     contains Parsed Character Data   *
    *   APPLIC    - optional single     contains TYPE, MODEL             *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  SEQNUM    - CDATA - REQUIRED - Sequence Number                    *
    *  TASKNAME  - CDATA - REQUIRED - Task Name                          *
    *  ID        - ID    - IMPLIED  - Unique identifier of taskitem      *
    ********************************************************************** -->

<!ELEMENT taskitem  - O (refs?, task?, applic?) >
<!ATTLIST taskitem
               seqnum   CDATA    #REQUIRED 
               taskname CDATA    #REQUIRED
               id       ID       #IMPLIED  >
<!-- Change attribute name taskid to taskname,
     Added id attribute to attribute definition list -->



<!--**********************************************************************
    * Define Element TASK (short task description) containing:-          *
    *   Parsed Character Data.                                           *
    ********************************************************************** -->

<!ELEMENT task  - O (#PCDATA) >


<!--**********************************************************************
    * Define Element Cat (Category) containing:-                         *
    *   No other tags.                                                   *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  CAT    - Declared - Category                                      *
    *  Attribute Definition list stored in entity %INSDEL;               *
    ********************************************************************** -->

<!ELEMENT cat  - O  EMPTY  >
<!ATTLIST cat
             cat (1 , 2)  "1"  
             %INSDEL;  >



<!--**********************************************************************
    * Define Element refinspec (inspection reference) containing:-       *
    *  No other tags                                                     *
    *@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*
    * Attribute(s):-                                                     *
    *  insptype    - CDATA - Required  - Inspection Type                 *
    *  Attribute Definition list stored in entity %bodyatt;              *
    ********************************************************************** -->

<!ELEMENT refinspec  - O  EMPTY  >
<!ATTLIST refinspec
             insptype CDATA #REQUIRED   
             %bodyatt; >
<!-- changed %INSDEL; to %bodyatt; -->


<!--**********************************************************************
    * Call the Preliminary Requirements Public Text.                     *
    * The formal public identifier is stored in the entity %PRELREQ;     *
    ********************************************************************** -->

%PRELREQ;



<!--**********************************************************************
    * Call the Lists Public Text.                                        *
    * The formal public identifier is stored in the entity %EXTLIST;     *
    ********************************************************************** -->
 
%EXTLIST;
 

 
<!-- Deleted entity reference %MANUFCT; -->
 


<!--**********************************************************************
    * Call the Warning, Caution, Note, Para Public Text.                 *
    * The formal public identifier is stored in the entity %WCNP;        *
    ********************************************************************** -->
 
%WCNP;
 

 
<!--**********************************************************************
    * Call the Figure And Table Public Text.                             *
    * The formal public identifier is stored in the entity %EXTFTAB;     *
    ********************************************************************** -->
 
%EXTFTAB;
