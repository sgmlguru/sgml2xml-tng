<!--**********************************************************************
    * Define Entity %COMPS; (Components) containing:- the formal public  *
    * identifier for the component definitions.                          *
    ********************************************************************** -->

<!ENTITY % COMPS
 PUBLIC "-//AECMA//ENTITIES Component Definitions 19990131//EN" >



<!--**********************************************************************
    * Call the Components Definition Public Text. The formal public      *
    * identifier is stored in the entity %COMPS;                         *
    ********************************************************************** -->

%COMPS;



<!-- Removal of entities %AGEDMC;, %AVEEDMC;, %AGEAPP; & %AVEEAPP; -->



<!--**********************************************************************
    * Call the AECMA Configuration Public Text.                          *
    * The formal public identifier is stored in the entity %AECMA;       *
    ********************************************************************** -->

%AECMA;



<!--**********************************************************************
    * Call the AECMA Base DTD Public Text. The formal public identifier  *
    * is stored in the entity %BASE;                                     *
    ********************************************************************** -->

%BASE;



<!--**********************************************************************
    * Call the Schedule Content Public Text.                             *
    * The formal public identifier is stored in the entity %SCHEDUL;     *
    ********************************************************************** -->

%SCHEDUL;



<!--**********************************************************************
    * Call the Content Breakdown Public Text. The formal public          *
    * identifier is stored in the entity %EXTCONT;                       *
    ********************************************************************** -->

%EXTCONT;
