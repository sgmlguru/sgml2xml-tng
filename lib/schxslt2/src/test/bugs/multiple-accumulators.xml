<testcase expect="valid" xmlns="https://doi.org/10.5281/zenodo.5679629#">
  <label>A schema may use multiple accumulators</label>
  <schemas>
    <sch:schema xmlns:sch="http://purl.oclc.org/dsdl/schematron" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" queryBinding="xslt3">
      <sch:ns prefix="xs" uri="http://www.w3.org/2001/XMLSchema"/>
      <xsl:accumulator name="acc-1" as="xs:integer" initial-value="0">
        <xsl:accumulator-rule match="*" select="$value + 1"/>
      </xsl:accumulator>
      <xsl:accumulator name="acc-2" as="xs:integer" initial-value="0">
        <xsl:accumulator-rule match="*" select="$value + 1"/>
      </xsl:accumulator>
      <sch:pattern>
        <sch:rule context="root">
          <sch:assert test="accumulator-before('acc-1') eq 1"/>
          <sch:assert test="accumulator-after('acc-2') eq 2"/>
        </sch:rule>
      </sch:pattern>
    </sch:schema>
  </schemas>
  <documents>
    <document filename="document.xml">
      <root xmlns="">
        <child/>
      </root>
    </document>
  </documents>
</testcase>
