<?xml version="1.0" encoding="UTF-8"?>
<models>
	
	<!-- @A means 'SGML' and @B means 'XML'; the values provide the type, if given, e.g. 'ent', 'pi' etc -->
    
    <model name="doc" description="This is the doc example document type">
        
        <!-- DOC XML DTD -->
    	<!-- @target idenmtifies the syntax -->
        <doctype root="(doc)" include="true" target="xml">
            <xslt-manifest>doc-xslt-manifest.xml</xslt-manifest>
            <xspec-manifest></xspec-manifest>
            
            <publicid>-//CWORD//DTD XML DOC TEST//EN</publicid>
            <systemid>doc.dtd</systemid>
        </doctype>
        
        <!-- DOC SGML DTD -->
    	<!-- @target idenmtifies the syntax -->
        <doctype root="(doc)" include="true" target="sgml">
            
            <publicid>-//CWORD//DTD DOC TEST//EN</publicid>
            <systemid>doc.dtd</systemid>
        </doctype>
        
        <!-- Maps (graphic entity to attr) -->
        <maps>
            <map source="name" target="href" A="ent" B="attr" start="sgml"/>
        </maps>
        
    </model>
    
</models>
